# Configuração de demonstração (portfólio)
# Para rodar localmente: copie para .env e execute `npm install && npm run seed && npm start`

NODE_ENV=development
PORT=3000
TZ=America/Sao_Paulo

# Banco de dados: SQLite por padrão (sem custo/infra). Use DB_DIALECT=postgres para PostgreSQL.
DB_DIALECT=sqlite
SQLITE_STORAGE=./data/database.sqlite

# PostgreSQL (opcional)
# DB_DIALECT=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=barbeariadoblack_db
# DB_USER=postgres
# DB_PASSWORD=postgres

BASE_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_SECRET=troque-esta-chave-em-producao

# WhatsApp (demo: desabilitado). Com WHATSAPP_ENABLED=false o histórico usa fallback e exibe o código na UI.
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_NAME=barbershop_session
# DEMO_SHOW_CODE=true  # true por padrão quando WhatsApp desabilitado

# Barbearia
BARBERSHOP_NAME=Barbearia Demo
BARBERSHOP_LOGO=/images/logo-barbearia.svg
BARBERSHOP_TAGLINE=Agende online de forma prática
BARBERSHOP_ADDRESS=Rua Exemplo, 123 - Centro
BARBERSHOP_HOURS=Seg-Sex 08:00-19:00 | Sáb 08:00-14:00
BARBERSHOP_MAPS_LINK=
PAYMENT_METHODS=Dinheiro,Cartão de Crédito,Cartão de Débito,PIX

# Contato e redes
WHATSAPP_BUSINESS_NUMBER=5563999999999
CONTACT_PHONE=(63) 99999-9999
CONTACT_EMAIL=contato@barbearia.local
INSTAGRAM_URL=
FACEBOOK_URL=
ADMIN_FAVICON=/images/favicon-admin.png

# --- Meta WhatsApp Cloud API (recomendado para deploy/Render) ---
# WHATSAPP_PROVIDER=cloud
# WHATSAPP_TOKEN=SEU_TOKEN_PERMANENTE
# WHATSAPP_PHONE_NUMBER_ID=SEU_PHONE_NUMBER_ID
# WHATSAPP_API_VERSION=v20.0
# WHATSAPP_DEFAULT_COUNTRY_CODE=55
