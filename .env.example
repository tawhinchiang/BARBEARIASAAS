NODE_ENV=development
PORT=3000
TZ=America/Sao_Paulo
TZ_OFFSET=-03:00

# PostgreSQL local
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=6543
DB_NAME=barbeariadoblack_db
DB_USER=postgres
DB_PASSWORD=postgres

BASE_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_SECRET=troque-esta-chave-em-producao

# WhatsApp
# false permite rodar e testar o sistema local sem abrir Puppeteer/QR Code.
# Para testar envio automatico via whatsapp-web.js, altere para true e escaneie o QR em /admin/config.
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_NAME=barbershop_session
DEBUG_WHATSAPP=false
ACK_SUCCESS_LEVEL=1
WHATSAPP_ACK_TIMEOUT=12000
WHATSAPP_SEND_TIMEOUT=10000

# Barbearia
BARBERSHOP_NAME=Barbearia Do Black
BARBERSHOP_LOGO=/images/doblack-logo.jpg
BARBERSHOP_TAGLINE=Agende online de forma pratica
BARBERSHOP_ADDRESS=R. Benjamin Azevedo, 1753, Xambioa - TO, 77880-000
BARBERSHOP_HOURS=Seg-Sex 08:00-19:00 | Sab 08:00-14:00
BARBERSHOP_MAPS_LINK=
PAYMENT_METHODS=Dinheiro,Cartao de Credito,Cartao de Debito,PIX

# Contato e redes
WHATSAPP_BUSINESS_NUMBER=5563999999999
CONTACT_PHONE=(63) 99999-9999
CONTACT_EMAIL=contato@barbearia.local
INSTAGRAM_URL=
FACEBOOK_URL=
ADMIN_FAVICON=/images/favicon-admin.png

# Google Calendar ainda esta incompleto neste projeto.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/admin/google-calendar/auth/callback
WEBHOOK_BASE_URL=http://127.0.0.1:3000
WEBHOOK_TOKEN_SECRET=troque-este-token
