NODE_ENV=development
PORT=3000

# Banco de dados PostgreSQL
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=barbershop_db
DB_USER=postgres
DB_PASSWORD=admin

# Sessão
SESSION_SECRET=sua_chave_secreta_muito_segura_aqui_123456789

# WhatsApp
WHATSAPP_SESSION_NAME=barbershop_session

# Barbearia
BARBERSHOP_NAME=BARBEARIA MARINHO
BARBERSHOP_LOGO=/images/logo.png
BARBERSHOP_ADDRESS=Av. das Américas, Qd 39 - Lt 03 - Jardim dos Ypês 1, Araguaína - TO, 77820-000
BARBERSHOP_MAPS_LINK=https://maps.app.goo.gl/cwHd1k4y1eZHink68

# Configurações Google Calendar
GOOGLE_CLIENT_ID=953726922773-gslj1pk75p8929898gilnv5m4fb7p0p3.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=http://localhost:3000/admin/google-calendar/auth/callback

# Configurações de Sincronização
SYNC_INTERVAL_MINUTES=15
SYNC_MAX_RETRIES=3
SYNC_RETRY_DELAY_MS=5000
SYNC_BATCH_SIZE=50
FULL_SYNC_INTERVAL_HOURS=24

# Configurações de Webhook
WEBHOOK_BASE_URL=http://localhost:3000
WEBHOOK_TOKEN_SECRET=sua_chave_webhook_secreta_aqui
WEBHOOK_EXPIRATION_HOURS=168
WEBHOOK_RENEW_BEFORE_HOURS=24

# Rate Limiting Google API
GOOGLE_REQUESTS_PER_MINUTE=100
GOOGLE_REQUESTS_PER_MINUTE_PER_USER=5
BACKOFF_MULTIPLIER=2
MAX_BACKOFF_MS=60000

# Configurações de Conflito
AUTO_RESOLVE_STRATEGY=prefer_recent
MAX_CONFLICT_AGE_HOURS=72
NOTIFY_ON_CONFLICT=true

# Configurações de Cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000

# Configurações de Mapeamento
EVENT_TITLE_PREFIX=[Barbearia]
INCLUDE_CLIENT_IN_TITLE=true
INCLUDE_CLIENT_PHONE=false
INCLUDE_PRICE=false
INCLUDE_NOTES=true
DEFAULT_LOCATION=Barbearia SaaS

# Cores por Tipo de Serviço (opcional)
SERVICE_COLOR_CORTE=#4285f4
SERVICE_COLOR_BARBA=#34a853
SERVICE_COLOR_COMBO=#ea4335
SERVICE_COLOR_DEFAULT=#9e9e9e

# Debug de WhatsApp (opcional)
DEBUG_WHATSAPP=true
