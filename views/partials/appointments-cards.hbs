<div class="card appointments-cards mb-3 text-white bg-dark border-start border-4 status-border-{{appointment.status}} rounded shadow-sm">
  <button class="btn w-100 text-start px-3 py-2 d-flex justify-content-between align-items-center js-toggle-card collapsed"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#collapse-{{appointment.id}}"
          aria-expanded="false"
          aria-controls="collapse-{{appointment.id}}">
    <div class="d-flex flex-column">
      <div class="fw-bold">{{appointment.client.firstName}} {{appointment.client.lastName}}</div>
      <small class="text-muted">{{appointment.appointmentDateFormatted}} às {{appointment.appointmentTimeFormatted}}</small>
    </div>
    <i class="fas fa-chevron-down toggle-icon"></i>
  </button>

  <div id="collapse-{{appointment.id}}" class="collapse px-3 py-2">
    <div class="row">
      <div class="col-md-6">
        <p class="mb-1"><strong><i class="fas fa-cut me-1"></i>Serviço:</strong> {{appointment.serviceType.name}} ({{appointment.serviceType.duration}} min)</p>
      </div>
      <div class="col-md-6">
        <p class="mb-1"><strong><i class="fas fa-money-bill-wave me-1"></i>Valor:</strong> {{formatCurrency appointment.totalPrice}}</p>
        <p class="mb-1"><strong><i class="fas fa-clipboard-list me-1"></i>Status:</strong> 
          <span class="status-badge status-{{appointment.status}}">{{statusText appointment.status}}</span>
        </p>
      </div>
    </div>

    <div class="text-end mt-3 d-flex flex-wrap justify-content-end gap-2">
      <button class="btn btn-sm btn-light action-item js-view-appointment" data-id="{{appointment.id}}">
        <i class="fas fa-eye"></i> Visualizar
      </button>
      <button class="btn btn-sm btn-outline-secondary action-item js-edit-appointment" data-id="{{appointment.id}}">
        <i class="fas fa-edit"></i> Editar
      </button>

      {{#if (eq appointment.status 'confirmed')}}
      <button class="btn btn-sm btn-outline-warning action-item js-no-show-appointment" data-id="{{appointment.id}}">
        <i class="fas fa-user-slash"></i> Não Compareceu
      </button>
      {{/if}}

      {{#unless appointment.whatsappSent}}
      <button class="btn btn-sm btn-success action-item js-send-whatsapp" data-id="{{appointment.id}}">
        <i class="fab fa-whatsapp"></i> WhatsApp
      </button>
      {{/unless}}

      {{#eq appointment.status 'pending'}}
      <button class="btn btn-sm btn-primary action-item js-confirm-appointment" data-id="{{appointment.id}}">
        <i class="fas fa-check"></i> Confirmar
      </button>
      {{/eq}}

      {{#unless (eq appointment.status 'cancelled')}}
        {{#unless (eq appointment.status 'completed')}}
          {{#if (eq appointment.status 'in_progress')}}
          <button class="btn btn-sm btn-success action-item js-complete-appointment" data-id="{{appointment.id}}">
            <i class="fas fa-check-double"></i> Concluir
          </button>
          {{/if}}
          <button class="btn btn-sm btn-outline-danger action-item js-cancel-appointment" data-id="{{appointment.id}}">
            <i class="fas fa-times"></i> Cancelar
          </button>
        {{/unless}}
      {{/unless}}
    </div>
  </div>
</div>
