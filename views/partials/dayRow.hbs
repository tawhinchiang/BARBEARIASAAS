<li class="list-group-item day-row">
  <span class="day-label">{{label}}</span>

  {{#with (lookup w day) as |d|}}
    <span class="day-times">
      <span class="chip">Manhã: {{timeRange d.morning}}</span>
      <span class="chip">Tarde: {{timeRange d.afternoon}}</span>
    </span>
  {{/with}}
</li>
