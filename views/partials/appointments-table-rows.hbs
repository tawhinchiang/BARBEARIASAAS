<!-- Navegação de datas - visível só no mobile -->
<div class="d-flex justify-content-between align-items-center mb-2 d-block d-md-none">
  <button id="prevDay" class="btn btn-sm btn-outline-secondary">&lt;</button>

  <div class="fw-bold text-center flex-grow-1">
    {{formatDate currentDateRaw}}, {{dayOfWeek currentDateRaw}}
  </div>

  <button id="nextDay" class="btn btn-sm btn-outline-secondary">&gt;</button>
</div>

<thead>
  <tr>
    <!-- ✅ Coluna fixa de horário -->
    <th class="text-center align-middle" style="width:100px;">Horário</th>

    <!-- ✅ Colunas por barbeiro -->
    {{#each barbers}}
      <th class="text-start align-middle">
        <div class="d-flex align-items-center">
          <div class="avatar-sm me-2">
            <img src="{{photo}}" alt="Foto de {{name}}" class="avatar-img">
          </div>
          <span class="fw-semibold">{{name}}</span>
        </div>
      </th>
    {{/each}}
  </tr>
</thead>

<tbody>
  {{#each timeSlots as |slot|}}
    <tr>
      <!-- Coluna fixa do horário -->
      <td class="text-center fw-semibold align-middle" style="width:100px;">
        {{slot.time}}
      </td>

      <!-- Colunas por barbeiro -->
      {{#each slot.cells as |cell|}}
        <td class="align-top {{#if cell.appointment}}js-appointment-cell{{/if}}"
            {{#if cell.appointment}}data-id="{{cell.appointment.id}}"{{/if}}>

{{#if cell.appointment}}
  {{#if cell.appointment.isEncaixe}}
    <!-- Card para ENCAIXE -->
    <div class="slot-fitin d-flex justify-content-between align-items-center flex-wrap">
      <span class="fw-semibold">
        {{cell.appointment.client.firstName}} {{cell.appointment.client.lastName}}
      </span>
      <span>
        {{cell.appointment.serviceType.name}}
      </span>
      <span class="fw-bold">
        {{formatCurrency cell.appointment.totalPrice}}
      </span>
    </div>
  {{else}}
    <!-- Card normal -->
    <div class="slot-{{cell.appointment.status}} d-flex justify-content-between align-items-center flex-wrap">
      <span class="fw-semibold">
        {{cell.appointment.client.firstName}} {{cell.appointment.client.lastName}}
      </span>
      <span>
        {{cell.appointment.serviceType.name}}
      </span>
      <span class="fw-bold">
        {{formatCurrency cell.appointment.totalPrice}}
      </span>
    </div>
  {{/if}}
{{else}}
  <!-- Slot livre -->
  <div class="slot-free js-open-schedule d-flex justify-content-center align-items-center"
       data-barber="{{cell.barber.id}}"
       data-date="{{../dateRaw}}"
       data-time="{{slot.time}}">
  </div>
{{/if}}


        </td>
      {{/each}}
    </tr>
  {{/each}}
</tbody>
