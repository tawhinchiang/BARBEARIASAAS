<thead>
  <tr>
    <th class="text-center align-middle" style="width:100px;">Horário</th>
    {{#each barbers}}
      <th class="text-start align-middle">
        <div class="d-flex align-items-center">
          <div class="avatar-sm me-2">
            <img src="{{photo}}" alt="Foto de {{name}}" class="avatar-img">
          </div>
          <span class="fw-semibold">{{name}}</span>
        </div>
      </th>
    {{/each}}
  </tr>
</thead>


<tbody>
  {{#each timeSlots as |slot|}}
    <tr>
      <!-- Coluna fixa do horário -->
      <td class="text-center fw-semibold align-middle" style="width:100px;">
        {{slot.time}}
      </td>
      
      <!-- Colunas por barbeiro -->
      {{#each slot.cells as |cell|}}
        <td class="align-top {{#if cell.appointment}}js-appointment-cell{{/if}}"
            {{#if cell.appointment}}data-id="{{cell.appointment.id}}"{{/if}}>
          
          {{#if cell.appointment}}
            <div class="fw-semibold text-uppercase">
              {{cell.appointment.client.firstName}} {{cell.appointment.client.lastName}}
            </div>
            <div class="text-muted small"> 
              {{cell.appointment.serviceType.name}} ({{cell.appointment.serviceType.duration}} min)
            </div>
            <div class="fw-bold mt-1">
              {{formatCurrency cell.appointment.totalPrice}}
            </div>
            <div class="d-flex align-items-center gap-2 mt-1">
              <span class="status-badge status-{{cell.appointment.status}}">
                {{statusText cell.appointment.status}}
              </span>
            </div>
          {{else}}
            {{!-- <div class="text-success fw-semibold">Disponível</div> --}}
            <button class="btn btn-outline-success btn-sm js-open-schedule mt-1"
                    data-barber="{{cell.barber.id}}"
                    data-date="{{../dateRaw}}"
                    data-time="{{slot.time}}">
              Agendar
            </button>
          {{/if}}
        </td>
      {{/each}}
    </tr>
  {{/each}}
</tbody>
