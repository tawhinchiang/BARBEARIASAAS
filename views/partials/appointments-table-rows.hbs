{{#each appointments}}

<tr>
  <td class="d-none">
    <span class="fw-bold">#{{id}}</span>
  </td>
  
  <td>
      <div class="d-flex align-items-center">
      <div class="avatar-sm me-2">
         <img src="{{barber.photo}}" alt="Foto de {{barber.name}}" class="avatar-img">

      </div>
      <div class="fw-semibold">{{barber.name}}</div>
      
      </div>
  </td>

  <td class="text-center">
    <div class="fw-semibold">{{appointmentDateFormatted}}</div>
    <small class="text-muted">{{appointmentTimeFormatted}}</small>
  </td>


    <td class="text-left">
    
      <div>
        <div class="fw-semibold">{{client.firstName}} {{client.lastName}}</div>
        {{!-- <small class="text-muted">{{client.phone}}</small> --}}
      </div>
    
    </td>

 <td>
 <div class="fw-semibold">{{serviceType.name}}</div>
 <small class="text-muted">{{serviceType.duration}} min </small>

  </td>
<td class="text-center">
    <div class="fw-bold"> {{formatCurrency totalPrice}}</div>
  </td>
  <td class="text-center">
    <span class="status-badge status-{{status}}">
      {{#if (eq status 'confirmed')}}Confirmado
      {{!-- {{else if (eq status 'pending')}}Pendente --}}
      {{else if (eq status 'cancelled')}}Cancelado
      {{!-- {{else if (eq status 'completed')}}Concluído --}}
      {{else}}Desconhecido
      {{/if}}
    </span>

  </td>
  
  {{!-- <td>
    {{#if whatsappSent}}
    <span class="badge bg-success">
      <i class="fab fa-whatsapp"></i> Enviado
    </span>
    {{else}}
    <span class="badge bg-warning">
      <i class="fas fa-clock"></i> Pendente
    </span>
    {{/if}}
  </td> --}}
  <td class="text-center">
    <div class="actions-menu">
      <button class="btn btn-sm btn-secondary action-item js-toggle-actions" data-id="{{id}}">
        <i class="fas fa-ellipsis-v"></i>
      </button>
      <div class="actions-dropdown" id="actions-{{id}}">
        <button class="action-item js-view-appointment" data-id="{{id}}">
          <i class="fas fa-eye"></i> Visualizar
        </button>
        {{#unless whatsappSent}}
        <button class="action-item js-send-whatsapp" data-id="{{id}}">
          <i class="fab fa-whatsapp"></i> Enviar WhatsApp
        </button>
        {{/unless}}
        {{#eq status 'pending'}}
        <button class="action-item js-confirm-appointment" data-id="{{id}}">
          <i class="fas fa-check"></i> Confirmar
        </button>
        {{/eq}}
        {{#unless (eq status 'cancelled')}}
        <button class="action-item js-edit-appointment" data-id="{{id}}">
          <i class="fas fa-edit"></i> Editar
        </button>
        <button class="action-item danger js-cancel-appointment" data-id="{{id}}">
          <i class="fas fa-times"></i> Cancelar
        </button>
        {{/unless}}
      </div>
    </div>

  </td>
</tr>
{{/each}}