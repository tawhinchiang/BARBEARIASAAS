<div class="admin-dashboard fade-in-soft">
  <div class="container-fluid">
    <div class="row mt-5">
      <div class="col-12">
        <h2 id="cashierTitle" class="mb-4 d-flex align-items-center">
          <i class="fas fa-cash-register me-2"></i> Caixa
        </h2>

        <div id="cashierStatus" class="mb-3"></div>

        <div class="mb-4 cashier-actions">
          <button id="btnOpenCashier" class="btn btn-success me-2" data-bs-toggle="modal" data-bs-target="#openCashierModal">
            <i class="fas fa-door-open me-1"></i> Abrir Caixa
          </button>
          <button id="btnAddExpense" class="btn btn-warning me-2" disabled>
            <i class="fas fa-minus-circle me-1"></i> Lançar Despesa
          </button>
          <button id="btnCloseCashier" class="btn btn-danger" disabled>
            <i class="fas fa-door-closed me-1"></i> Fechar Caixa
          </button>
        </div>

        <div id="cashierSummary" class="row g-3"><!-- via JS --></div>

        <div class="card mt-4" id="cashierHistoryCard">
          <div class="card-header">
            <div class="d-flex align-items-center justify-content-between">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-clock-history me-1"></i> <strong>Histórico de Caixas</strong>
              </div>
              <button class="btn btn-outline-secondary btn-sm d-inline-flex d-md-none"
                type="button" data-bs-toggle="collapse" data-bs-target="#histFilters"
                aria-expanded="false" aria-controls="histFilters">
                <i class="bi bi-sliders me-1"></i> Filtros
              </button>
            </div>

            <div id="histFilters" class="collapse d-md-block mt-2">
              <div class="d-flex flex-wrap gap-2 align-items-center">
                <input type="date" id="histFrom" class="form-control form-control-sm hist-w">
                <input type="date" id="histTo"   class="form-control form-control-sm hist-w">

                <div class="btn-group btn-group-sm hist-range-group" role="group" aria-label="Atalhos de período">
                  <button class="btn btn-outline-secondary" data-range="today">Hoje</button>
                  <button class="btn btn-outline-secondary" data-range="yesterday">Ontem</button>
                  <button class="btn btn-outline-secondary" data-range="week">Semana</button>
                  <button class="btn btn-outline-secondary" data-range="month">Mês</button>
                </div>

                <select id="histPageSize" class="form-select form-select-sm hist-pagesize">
                  <option>10</option><option selected>20</option><option>50</option>
                </select>

                <button id="histSearchBtn" class="btn btn-primary btn-sm">
                  <i class="bi bi-search me-1"></i>
                  <span class="d-none d-sm-inline">Aplicar</span>
                </button>
              </div>
            </div>
          </div>

          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table mb-0 align-middle">
                <thead class="table-light">
                  <tr>
                    <th class="text-nowrap">Abertura</th>
                    <th class="text-nowrap">Fechamento</th>
                    <th>Status</th>
                    <th class="text-end">Entradas</th>
                    <th class="text-end d-none d-sm-table-cell">Despesas</th>
                    <th class="text-end d-none d-sm-table-cell">Resultado</th>
                    <th class="text-end d-none d-sm-table-cell">Dif. Dinheiro</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody id="histTbody"><!-- via JS --></tbody>
              </table>
            </div>
            <div class="d-flex justify-content-between align-items-center p-2">
              <small id="histSummary"></small>
              <nav><ul class="pagination pagination-sm mb-0" id="histPagination"></ul></nav>
            </div>
          </div>
        </div>

        <!-- Modal Detalhes (tema padrão já aplicado via .app-modal) -->
        <div class="modal fade app-modal" id="sessionDetailModal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-receipt-cutoff me-2"></i> Detalhes da Sessão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body" id="sessionDetailBody"><!-- via JS --></div>
              <div class="modal-footer">
                <button class="btn btn-primary" data-bs-dismiss="modal">Fechar</button>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- Modal Abrir Caixa -->
<div class="modal fade app-modal" id="openCashierModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="fas fa-door-open me-2"></i> Abrir Caixa</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label">Valor inicial em dinheiro</label>
        <div class="input-group">
          <span class="input-group-text">R$</span>
          <input type="number" id="openingAmount" class="form-control" step="0.01" min="0" value="0.00">
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-primary" id="confirmOpenCashier">Abrir</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Despesa -->
<div class="modal fade app-modal" id="expenseModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-dash-circle me-2"></i> Lançar Despesa</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-2">
          <label class="form-label">Descrição <span class="text-danger">*</span></label>
          <input id="exp-desc" type="text" class="form-control" placeholder="Ex.: Energia, Água, Taxa maquininha, etc.">
        </div>
        <div class="row g-2">
          <div class="col-6">
            <label class="form-label">Valor <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text">R$</span>
              <input id="exp-amount" type="number" min="0.01" step="0.01" class="form-control" placeholder="0,00">
            </div>
          </div>
          <div class="col-6">
            <label class="form-label">Método (saída do caixa)</label>
            <select id="exp-method" class="form-select">
              <option value="cash">Dinheiro</option>
              <option value="pix">Pix</option>
              <option value="credit">Cartão Crédito</option>
              <option value="debit">Cartão Débito</option>
              <option value="other">Outros</option>
            </select>
          </div>
        </div>
        <div class="row g-2 mt-0">
          <div class="col-6">
            <label class="form-label">Categoria</label>
            <select id="exp-category" class="form-select">
              <option value="operacional">Operacional</option>
              <option value="taxa_maquininha">Taxa maquininha</option>
              <option value="outras">Outras</option>
            </select>
          </div>
          <div class="col-6">
            <label class="form-label">Data</label>
            <input id="exp-date" type="date" class="form-control">
          </div>
        </div>
        <div id="exp-alert" class="alert alert-danger py-2 px-3 mt-2 d-none"></div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button id="exp-submit-btn" class="btn btn-primary">Lançar</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Fechar Caixa -->
<div class="modal fade app-modal" id="closeCashierModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-bell me-2"></i> Fechar Caixa</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row g-2 mb-3">
          <div class="col-6 col-md-4">
            <div class="border rounded p-2">
              <div class="small text-muted">Entradas (esperado)</div>
              <div id="cc-expected-total" class="fw-bold">R$ 0,00</div>
            </div>
          </div>
          <div class="col-6 col-md-4">
            <div class="border rounded p-2">
              <div class="small text-muted">Despesas (lançadas)</div>
              <div id="cc-expenses-total" class="fw-bold">R$ 0,00</div>
            </div>
          </div>
          <div class="col-12 col-md-4">
            <div class="border rounded p-2">
              <div class="small text-muted">Resultado (E - D)</div>
              <div id="cc-result-expected" class="fw-bold">R$ 0,00</div>
            </div>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-striped align-middle mb-2 cc-table">
            <thead>
              <tr>
                <th>Método</th>
                <th class="text-end">Esperado</th>
                <th>Contado</th>
                <th class="text-end">Diferença</th>
              </tr>
            </thead>
            <tbody id="cc-count-tbody"><!-- via JS --></tbody>
            <tfoot>
              <tr>
                <th>Total</th>
                <th class="text-end" id="cc-expected-sum">R$ 0,00</th>
                <th><input id="cc-counted-sum" type="text" class="form-control text-end bg-white text-dark" readonly></th>
                <th class="text-end" id="cc-diff-sum">R$ 0,00</th>
              </tr>
            </tfoot>
          </table>
        </div>

        <div id="cc-diff-alert" class="alert alert-warning d-none py-2 px-3">
          Existem diferenças entre o esperado e o contado. Revise antes de fechar.
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button id="cc-submit-btn" class="btn btn-primary">Fechar Caixa</button>
      </div>
    </div>
  </div>
</div>

<style>
#cashierTitle {
  color: var(--cashier-title-color, #fff);
  font-weight: 600;
  letter-spacing: .2px;
}
.cashier-actions {
  display: flex;
  flex-wrap: wrap;
  gap: .5rem;
}
@media (min-width:577px) {
  .cashier-actions .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: .6rem 1rem;
    min-width: 150px;
    font-size: .95rem;
    line-height: 1.2;
  }
}

.modal {
  z-index: 2000;
}
.modal-backdrop {
  z-index: 1995;
  opacity: .45;
}
body.modal-open {
  overflow: hidden !important;
}
body.modal-open .fade-in-soft,
body.modal-open .admin-dashboard,
body.modal-open .container-fluid,
body.modal-open .row,
body.modal-open .col-12 {
  transform: none;
  filter: none;
  perspective: none;
  will-change: auto;
}

#cashierHistoryCard {
  --hist-bg: var(--bg-light);
  --hist-surface: var(--bg-gray);
  --hist-border: var(--border-color);
  --hist-text: var(--text-dark);
}
#cashierHistoryCard .card-header {
  background: var(--hist-bg);
  border-bottom: 1px solid var(--hist-border);
}
#cashierHistoryCard .card-header strong,
#cashierHistoryCard .card-header .bi {
  color: #fff;
}
#cashierHistoryCard .hist-w {
  min-width: 160px;
}
#cashierHistoryCard .hist-pagesize {
  width: 84px;
  min-width: 84px;
}
#cashierHistoryCard .hist-range-group {
  overflow-x: auto;
  white-space: nowrap;
  max-width: 100%;
}
#cashierHistoryCard .form-control.form-control-sm,
#cashierHistoryCard .form-select.form-select-sm {
  background: #1e1e22;
  border: 1px solid var(--hist-border);
  color: var(--hist-text);
  height: 38px;
  padding: .35rem .6rem;
}
#cashierHistoryCard thead.table-light th {
  background: #202026;
  color: var(--hist-text);
  border-color: var(--hist-border);
}
#cashierHistoryCard tbody td {
  background: #18181c;
  border-color: var(--hist-border);
}
#cashierHistoryCard tbody tr:hover td {
  background: #1d1d22;
}
#cashierHistoryCard #histSearchBtn.btn {
  background: #fff;
  color: #000;
  border: 1px solid #ced4da;
  height: 38px;
  padding: .35rem .75rem;
}
#cashierHistoryCard #histSearchBtn.btn i {
  color: #000;
}
#cashierHistoryCard .card-body + .d-flex {
  background: var(--hist-bg);
  border-top: 1px solid var(--hist-border);
}
#cashierHistoryCard .pagination .page-link {
  color: var(--primary-color);
  border-color: var(--primary-color);
  background: transparent;
}
#cashierHistoryCard .pagination .page-item.active .page-link {
  background: #fff;
  color: #000;
  border-color: var(--primary-color);
}
#cashierHistoryCard .pagination .page-item:first-child .page-link,
#cashierHistoryCard .pagination .page-item:last-child .page-link {
  background: #fff;
  color: #000;
  border-color: #ced4da;
}
#cashierHistoryCard .btn-icon-xs {
  --bs-btn-padding-y: .25rem;
  --bs-btn-padding-x: .45rem;
  --bs-btn-font-size: .8rem;
  line-height: 1.1;
  min-width: 32px;
}
#cashierHistoryCard .btn-icon-xs i {
  color: #000;
}

.app-modal .modal-dialog {
  margin: calc(env(safe-area-inset-top, 0px) + 64px) auto 16px;
}
.app-modal .modal-content {
  background: #1e1e22;
  color: #fff;
  border: 0;
  display: flex;
  max-height: calc(100dvh - 96px);
}
.app-modal .modal-header {
  background: #2a2a30;
  color: #fff;
  border-bottom: 1px solid rgba(255,255,255,.12);
}
.app-modal .modal-body {
  overflow: auto;
  font-size: .9rem;
}
.app-modal .modal-footer {
  background: #1b1b20;
  border-top: 1px solid rgba(255,255,255,.08);
  padding: .75rem 1rem;
  justify-content: space-between;
}
.app-modal .btn-close {
  filter: invert(1);
}
.app-modal .modal-footer .btn {
  background: #fff;
  color: #000;
  border: 1px solid #ced4da;
  border-radius: .375rem;
  font-weight: 500;
  min-width: 120px;
  font-size: .9rem;
  padding: .45rem .9rem;
}
.app-modal .modal-footer .btn:hover {
  background: #f8f9fa;
  border-color: #bdbdbd;
}

.app-modal .form-control,
.app-modal .form-select,
.app-modal .input-group-text {
  height: 38px;
  padding: .45rem .6rem;
  font-size: .9rem;
  line-height: 1.2;
}
.app-modal label.form-label {
  font-size: .85rem;
  margin-bottom: .25rem;
}
.app-modal .form-control,
.app-modal .form-select {
  background: #fff;
  color: #212529;
  border-color: #ced4da;
}
.app-modal .input-group-text {
  background: #f8f9fa;
  color: #212529;
  border-color: #ced4da;
}

#expenseModal .input-group-text {
  width: 42px;
  justify-content: center;
  padding: .4rem .5rem;
}
#expenseModal .form-control,
#expenseModal .form-select {
  border-color: #ced4da;
  font-size: .9rem;
}
#expenseModal .row.g-2 > .col-6 {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.cc-table {
  table-layout: fixed;
  width: 100%;
  font-size: .85rem;
  border-collapse: collapse;
}
.cc-table thead tr {
  background: #2f2f36;
}
.cc-table thead th {
  color: #fff;
  font-weight: 600;
  text-align: left;
  padding: .4rem .45rem;
  font-size: .8rem;
  border-bottom: 1px solid rgba(255,255,255,.15);
}
.cc-table td {
  background: #1f1f26;
  color: #fff;
  padding: .4rem .45rem;
  vertical-align: middle;
  border-bottom: 1px solid rgba(255,255,255,.08);
}
.cc-table th:nth-child(1),
.cc-table td:nth-child(1) { width: 30%; }
.cc-table th:nth-child(2),
.cc-table td:nth-child(2) { width: 22%; text-align: right; }
.cc-table th:nth-child(3),
.cc-table td:nth-child(3) { width: 26%; }
.cc-table th:nth-child(4),
.cc-table td:nth-child(4) { width: 22%; text-align: right; }
.cc-table .input-group {
  max-width: 130px;
  margin-left: auto;
  margin-right: auto;
}
.cc-table .input-group-text {
  width: 34px;
  padding: .3rem .4rem;
  font-size: .8rem;
  flex: 0 0 34px;
}
.cc-table .form-control {
  height: 32px;
  padding: .3rem .4rem;
  font-size: .85rem;
  text-align: right;
}
.app-modal .table-responsive {
  overflow-x: hidden;
}

@media (max-width:576.98px) {
  #histSearchBtn .d-none.d-sm-inline {
    display: inline !important;
  }
  #cashierTitle {
    font-size: 1.25rem;
  }
  #cashierHistoryCard {
    font-size: 12px;
  }
  #cashierHistoryCard .card-header {
    position: sticky;
    top: 56px;
    z-index: 2;
    background: #202026;
  }
  #cashierHistoryCard .card-header strong {
    font-size: .9rem;
  }
  #cashierHistoryCard .d-flex.flex-wrap.gap-2.align-items-center > * {
    flex: 1 1 100%;
  }
  #cashierHistoryCard .hist-w,
  #cashierHistoryCard .hist-pagesize {
    width: 100%;
    min-width: 0;
  }
  #cashierHistoryCard .btn-group.hist-range-group {
    width: 100%;
  }
  #cashierHistoryCard #histFilters {
    background: #1e1e22;
