<div class="admin-dashboard fade-in-soft">
  <div class="container-fluid">
    <div class="row mt-5">
      <div class="col-12">
        <h2 id="cashierTitle" class="mb-4 d-flex align-items-center">
          <i class="fas fa-cash-register me-2"></i> Caixa
        </h2>

        <!-- Status atual -->
        <div id="cashierStatus" class="mb-3">
          {{!-- Aqui via JS você vai preencher se está aberto ou fechado --}}
        </div>

        <!-- Botões de ações -->

        <div class="mb-4 cashier-actions">
          <button id="btnOpenCashier" class="btn btn-success me-2" data-bs-toggle="modal" data-bs-target="#openCashierModal">
            <i class="fas fa-door-open me-1"></i> Abrir Caixa
          </button>

          <button id="btnAddExpense" class="btn btn-warning me-2" disabled>
            <i class="fas fa-minus-circle me-1"></i> Lançar Despesa
          </button>

          <button id="btnCloseCashier" class="btn btn-danger" disabled>
            <i class="fas fa-door-closed me-1"></i> Fechar Caixa
          </button>
        </div>


        <!-- Resumo da sessão atual -->
        <div id="cashierSummary" class="row g-3">
          <!-- preenchido via JS com /admin/cashier/session/current -->
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal Abrir Caixa -->
<div class="modal fade" id="openCashierModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title"><i class="fas fa-door-open me-2"></i> Abrir Caixa</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label">Valor inicial em dinheiro</label>
        <div class="input-group">
          <span class="input-group-text">R$</span>
          <input type="number" id="openingAmount" class="form-control" step="0.01" min="0" value="0.00">
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary btn-uniform" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-success btn-uniform" id="confirmOpenCashier">Abrir</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Despesa -->
<div class="modal fade" id="expenseModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 bg-white text-dark">
      <div class="modal-header bg-warning">
        <h5 class="modal-title"><i class="bi bi-dash-circle me-2"></i> Lançar Despesa</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body">
        <div class="mb-2">
          <label class="form-label">Descrição <span class="text-danger">*</span></label>
          <input id="exp-desc" type="text" class="form-control" placeholder="Ex.: Energia, Água, Taxa maquininha, etc.">
        </div>

        <div class="row g-2">
          <div class="col-6">
            <label class="form-label">Valor <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text">R$</span>
              <input id="exp-amount" type="number" min="0.01" step="0.01" class="form-control" placeholder="0,00">
            </div>
          </div>
          <div class="col-6">
            <label class="form-label">Método (saída do caixa)</label>
            <select id="exp-method" class="form-select">
              <option value="cash">Dinheiro</option>
              <option value="pix">Pix</option>
              <option value="credit">Cartão Crédito</option>
              <option value="debit">Cartão Débito</option>
              <option value="other">Outros</option>
            </select>
          </div>
        </div>

        <div class="row g-2 mt-0">
          <div class="col-6">
            <label class="form-label">Categoria</label>
            <select id="exp-category" class="form-select">
              <option value="operacional">Operacional</option>
              {{!-- <option value="fixa">Fixa (mensal)</option> --}}
              <option value="taxa_maquininha">Taxa maquininha</option>
              <option value="outras">Outras</option>
            </select>
          </div>
          <div class="col-6">
            <label class="form-label">Data</label>
            <input id="exp-date" type="date" class="form-control">
          </div>
        </div>
{{!-- 
        <div class="form-check mt-2">
          <input class="form-check-input" type="checkbox" id="exp-fixed">
          <label class="form-check-label" for="exp-fixed">Cadastrar como despesa fixa mensal</label>
        </div> --}}

        {{!-- <div class="mt-2">
          <label class="form-label small">Observações</label>
          <textarea id="exp-notes" class="form-control" rows="2" placeholder="Obs. (opcional)"></textarea>
        </div> --}}

        <div id="exp-alert" class="alert alert-danger py-2 px-3 mt-2 d-none"></div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-dark btn-uniform" data-bs-dismiss="modal">Cancelar</button>
        <button id="exp-submit-btn" class="btn btn-warning btn-uniform">Lançar</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Fechar Caixa -->
<div class="modal fade" id="closeCashierModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <div class="modal-content border-0">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title"><i class="bi bi-bell me-2"></i> Fechar Caixa</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>

      <div class="modal-body">
        <!-- Resumo esperado (preenchido via JS) -->
        <div class="row g-2 mb-3">
          <div class="col-6 col-md-4">
            <div class="border rounded p-2">
              <div class="small text-muted">Entradas (esperado)</div>
              <div id="cc-expected-total" class="fw-bold">R$ 0,00</div>
            </div>
          </div>
          <div class="col-6 col-md-4">
            <div class="border rounded p-2">
              <div class="small text-muted">Despesas (lançadas)</div>
              <div id="cc-expenses-total" class="fw-bold">R$ 0,00</div>
            </div>
          </div>
          <div class="col-12 col-md-4">
            <div class="border rounded p-2">
              <div class="small text-muted">Resultado (E - D)</div>
              <div id="cc-result-expected" class="fw-bold">R$ 0,00</div>
            </div>
          </div>
        </div>

        <!-- Contagem por método -->
        <div class="table-responsive">
          <table class="table table-striped align-middle mb-2">
            <thead>
              <tr>
                <th>Método</th>
                <th class="text-end">Esperado</th>
                <th style="width: 180px;">Contado</th>
                <th class="text-end">Diferença</th>
              </tr>
            </thead>
            <tbody id="cc-count-tbody">
              <!-- linhas criadas via JS -->
            </tbody>
            <tfoot>
              <tr>
                <th>Total</th>
                <th class="text-end" id="cc-expected-sum">R$ 0,00</th>
                <th><input id="cc-counted-sum" type="text" class="form-control text-end text-dark bg-white" readonly></th>
                <th class="text-end" id="cc-diff-sum">R$ 0,00</th>
              </tr>
            </tfoot>
          </table>
        </div>

        <div id="cc-diff-alert" class="alert alert-warning d-none py-2 px-3">
          Existem diferenças entre o esperado e o contado. Revise antes de fechar.
        </div>

        {{!-- <div class="mb-2">
          <label class="form-label small text-muted">Observações</label>
          <textarea id="cc-notes" class="form-control" rows="2" placeholder="Obs. (opcional)"></textarea>
        </div> --}}

        {{!-- <div class="form-check">
          <input class="form-check-input" type="checkbox" id="cc-print">
          <label class="form-check-label" for="cc-print">Imprimir recibo de fechamento</label>
        </div> --}}
      </div>

      <div class="modal-footer">
        <button class="btn btn-dark btn-uniform" data-bs-dismiss="modal">Cancelar</button>
        <button id="cc-submit-btn" class="btn btn-danger btn-uniform">Fechar Caixa</button>
      </div>
    </div>
  </div>
</div>

<style>
  #cashierTitle{
    color: var(--cashier-title-color, #fff) !important;
    font-weight: 600;
    letter-spacing: .2px;
  }
  @media (max-width: 576.98px){
    #cashierTitle{ font-size: 1.25rem; }
  }

  #closeCashierModal{ --brand-primary: var(--primary-color, var(--bs-primary, #0d6efd)); }
  #closeCashierModal .modal-content{ background:#fff !important; color:#212529 !important; }
  #closeCashierModal .modal-header{ background:#dc3545 !important; color:#fff !important; }
  #closeCashierModal .btn-close, #closeCashierModal .btn-close-white{ filter: invert(1); }
  #closeCashierModal .modal-body{ color:#212529 !important; }
  #closeCashierModal .text-muted{ color:#6c757d !important; }

  #closeCashierModal .table thead tr{ background: var(--brand-primary) !important; }
  #closeCashierModal .table thead th{ color:#fff !important; border-color: rgba(255,255,255,.25) !important; }
  #closeCashierModal .table tbody tr, #closeCashierModal .table tfoot tr{ background: var(--brand-primary) !important; }
  #closeCashierModal .table{
    --bs-table-color:#fff; --bs-table-striped-color:#fff; --bs-table-hover-color:#fff;
  }
  #closeCashierModal .table *:not(.form-control):not(.input-group-text){ color:#fff !important; opacity:1 !important; }
  #closeCashierModal .table tbody td,
  #closeCashierModal .table tfoot th,
  #closeCashierModal .table tfoot td{ border-color: rgba(255,255,255,.15) !important; }
  #closeCashierModal .table .text-muted{ color:#fff !important; opacity:1 !important; }

  #openCashierModal .input-group-text,   #openCashierModal .form-control,   #openCashierModal .form-select,
  #expenseModal   .input-group-text,     #expenseModal   .form-control,     #expenseModal   .form-select,
  #closeCashierModal .input-group-text,  #closeCashierModal .form-control,  #closeCashierModal .form-select{
    height: 40px;
    padding: .5rem .65rem;
    font-size: .95rem;
    line-height: 1.2;
    background:#fff !important;
    color:#212529 !important;
    border-color:#ced4da !important;
  }
  #openCashierModal .input-group-text,
  #expenseModal .input-group-text,
  #closeCashierModal .input-group-text{
    background:#f8f9fa !important;
  }

  #closeCashierModal .form-control:disabled,
  #closeCashierModal .form-control[readonly]{ background:#f8f9fa !important; color:#212529 !important; }
  #closeCashierModal .form-control::placeholder{ color:#6c757d !important; opacity:1; }
  #closeCashierModal #cc-counted-sum{ text-align:right; background:#fff !important; color:#212529 !important; }

  #openCashierModal .btn, #expenseModal .btn, #closeCashierModal .btn{
    padding: .5rem .9rem;
    font-size: .9rem;
    min-width: 128px;
    line-height: 1.2;
  }
  .btn-uniform{ padding: .5rem .9rem; font-size: .9rem; min-width: 128px; line-height: 1.2; }

  .cashier-actions{
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }
  @media (min-width: 577px){
    .cashier-actions .btn{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: .6rem 1rem;
      min-width: 150px;
      font-size: .95rem;
      line-height: 1.2;
    }
  }

  #expenseModal .form-label,
  #expenseModal label,
  #expenseModal .form-check-label{ color:#212529 !important; }
  #expenseModal .text-danger{ color:#dc3545 !important; }
  #expenseModal .modal-header,
  #expenseModal .modal-header .modal-title,
  #expenseModal .modal-header i{ color:#212529 !important; }

  @media (max-width: 576.98px){
    #closeCashierModal .modal-dialog{ margin:.75rem !important; max-width:100%; }
    #closeCashierModal .modal-content{ border-radius:.6rem !important; max-height:calc(100dvh - 1.5rem); overflow:hidden; }
    #closeCashierModal .modal-body{ max-height:calc(100dvh - 7.5rem); overflow:auto !important; -webkit-overflow-scrolling:touch; }
    #closeCashierModal .modal-header, #closeCashierModal .modal-footer{ padding:.5rem .75rem !important; }
    #closeCashierModal .modal-title{ font-size:.95rem; }
    #closeCashierModal .modal-body .border.rounded.p-2{ padding:.5rem !important; }
    #closeCashierModal .modal-body .small{ font-size:.72rem !important; }
    #closeCashierModal .modal-body .fw-bold{ font-size:.9rem !important; }
    #closeCashierModal .table{ font-size:.78rem; }
    #closeCashierModal .table>:not(caption)>*>*{ padding:.35rem .4rem !important; }
    #closeCashierModal .table thead th{ font-size:.75rem; white-space:nowrap; }
    #closeCashierModal .table thead th:nth-child(3),
    #closeCashierModal .table tbody td:nth-child(3){ width:132px !important; }
    #closeCashierModal .input-group-text{ padding:.35rem .45rem !important; }
    #closeCashierModal .form-control{ padding:.35rem .5rem !important; height:36px; }
    #closeCashierModal .form-select{ height:36px; }

    #expenseModal .modal-header, #expenseModal .modal-footer{ padding:.5rem .75rem; }
    #expenseModal .modal-title{ font-size:.95rem; }
    #expenseModal textarea.form-control{ height:96px; }

    #openCashierModal .btn, #expenseModal .btn, #closeCashierModal .btn{ min-width:132px; font-size:.92rem; padding:.5rem .9rem; }

    #openCashierModal input,  #openCashierModal select,  #openCashierModal textarea,
    #expenseModal input,      #expenseModal select,      #expenseModal textarea,
    #closeCashierModal input, #closeCashierModal select, #closeCashierModal textarea{ font-size:16px !important; }

    .cashier-actions{ display:block; }
    .cashier-actions .btn{
      display:block;
      width:100%;
      min-width:0;
      min-height:44px;
      margin:0 0 .5rem 0;
      border-radius:10px;
      text-align:center;
    }
    .cashier-actions .btn:last-child{ margin-bottom:0; }
    .cashier-actions .me-2{ margin-right:0 !important; }
  }
</style>

<script src="/js/cashier.js"></script>
