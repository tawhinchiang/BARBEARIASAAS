<div class="admin-dashboard fade-in-soft">
  <div class="container-fluid">
    <div class="row mt-5">
      <div class="col-12">
        <h2 id="cashierTitle" class="mb-4 d-flex align-items-center">
          <i class="fas fa-cash-register me-2"></i> Caixa
        </h2>

        <!-- Status atual -->
        <div id="cashierStatus" class="mb-3"></div>

        <!-- Ações -->
        <div class="mb-4 cashier-actions">
          <button id="btnOpenCashier" class="btn btn-success me-2" data-bs-toggle="modal" data-bs-target="#openCashierModal">
            <i class="fas fa-door-open me-1"></i> Abrir Caixa
          </button>

          <button id="btnAddExpense" class="btn btn-warning me-2" disabled>
            <i class="fas fa-minus-circle me-1"></i> Lançar Despesa
          </button>

          <button id="btnCloseCashier" class="btn btn-danger" disabled>
            <i class="fas fa-door-closed me-1"></i> Fechar Caixa
          </button>
        </div>

        <!-- Resumo -->
        <div id="cashierSummary" class="row g-3"><!-- via JS --></div>

        <!-- Histórico -->
        <div class="card mt-4" id="cashierHistoryCard">
          <div class="card-header">
            <div class="d-flex align-items-center justify-content-between">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-clock-history me-1"></i> <strong>Histórico de Caixas</strong>
              </div>
              <button class="btn btn-outline-secondary btn-sm d-inline-flex d-md-none"
                      type="button" data-bs-toggle="collapse" data-bs-target="#histFilters"
                      aria-expanded="false" aria-controls="histFilters">
                <i class="bi bi-sliders me-1"></i> Filtros
              </button>
            </div>

            <div id="histFilters" class="collapse d-md-block mt-2">
              <div class="d-flex flex-wrap gap-2 align-items-center">
                <input type="date" id="histFrom" class="form-control form-control-sm hist-w">
                <input type="date" id="histTo"   class="form-control form-control-sm hist-w">

                <div class="btn-group btn-group-sm hist-range-group" role="group" aria-label="Atalhos de período">
                  <button class="btn btn-outline-secondary" data-range="today">Hoje</button>
                  <button class="btn btn-outline-secondary" data-range="yesterday">Ontem</button>
                  <button class="btn btn-outline-secondary" data-range="week">Semana</button>
                  <button class="btn btn-outline-secondary" data-range="month">Mês</button>
                </div>

                <select id="histPageSize" class="form-select form-select-sm hist-pagesize">
                  <option>10</option><option selected>20</option><option>50</option>
                </select>

                <button id="histSearchBtn" class="btn btn-primary btn-sm">
                  <i class="bi bi-search me-1"></i>
                  <span class="d-none d-sm-inline">Aplicar</span>
                </button>
              </div>
            </div>
          </div>

          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table mb-0 align-middle">
                <thead class="table-light">
                  <tr>
                    <th class="text-nowrap">Abertura</th>
                    <th class="text-nowrap">Fechamento</th>
                    <th>Status</th>
                    <th class="text-end">Entradas</th>
                    <th class="text-end d-none d-sm-table-cell">Despesas</th>
                    <th class="text-end d-none d-sm-table-cell">Resultado</th>
                    <th class="text-end d-none d-sm-table-cell">Dif. Dinheiro</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody id="histTbody"><!-- via JS --></tbody>
              </table>
            </div>
            <div class="d-flex justify-content-between align-items-center p-2">
              <small id="histSummary"></small>
              <nav><ul class="pagination pagination-sm mb-0" id="histPagination"></ul></nav>
            </div>
          </div>
        </div>

        <!-- Modal Detalhe -->
        <div class="modal fade" id="sessionDetailModal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title"><i class="bi bi-receipt-cutoff me-2"></i> Detalhes da Sessão</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="sessionDetailBody"><!-- via JS --></div>
            <div class="modal-footer">
              <button class="btn btn-primary" data-bs-dismiss="modal">Fechar</button>
            </div>
          </div></div>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- Modal Abrir Caixa -->
<div class="modal fade" id="openCashierModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title"><i class="fas fa-door-open me-2"></i> Abrir Caixa</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label">Valor inicial em dinheiro</label>
        <div class="input-group">
          <span class="input-group-text">R$</span>
          <input type="number" id="openingAmount" class="form-control" step="0.01" min="0" value="0.00">
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary btn-uniform" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-success btn-uniform" id="confirmOpenCashier">Abrir</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Despesa -->
<div class="modal fade" id="expenseModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 bg-white text-dark">
      <div class="modal-header bg-warning">
        <h5 class="modal-title"><i class="bi bi-dash-circle me-2"></i> Lançar Despesa</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <div class="mb-2">
          <label class="form-label">Descrição <span class="text-danger">*</span></label>
          <input id="exp-desc" type="text" class="form-control" placeholder="Ex.: Energia, Água, Taxa maquininha, etc.">
        </div>
        <div class="row g-2">
          <div class="col-6">
            <label class="form-label">Valor <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text">R$</span>
              <input id="exp-amount" type="number" min="0.01" step="0.01" class="form-control" placeholder="0,00">
            </div>
          </div>
          <div class="col-6">
            <label class="form-label">Método (saída do caixa)</label>
            <select id="exp-method" class="form-select">
              <option value="cash">Dinheiro</option>
              <option value="pix">Pix</option>
              <option value="credit">Cartão Crédito</option>
              <option value="debit">Cartão Débito</option>
              <option value="other">Outros</option>
            </select>
          </div>
        </div>
        <div class="row g-2 mt-0">
          <div class="col-6">
            <label class="form-label">Categoria</label>
            <select id="exp-category" class="form-select">
              <option value="operacional">Operacional</option>
              <option value="taxa_maquininha">Taxa maquininha</option>
              <option value="outras">Outras</option>
            </select>
          </div>
          <div class="col-6">
            <label class="form-label">Data</label>
            <input id="exp-date" type="date" class="form-control">
          </div>
        </div>
        <div id="exp-alert" class="alert alert-danger py-2 px-3 mt-2 d-none"></div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-dark btn-uniform" data-bs-dismiss="modal">Cancelar</button>
        <button id="exp-submit-btn" class="btn btn-warning btn-uniform">Lançar</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Fechar Caixa -->
<div class="modal fade" id="closeCashierModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <div class="modal-content border-0">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title"><i class="bi bi-bell me-2"></i> Fechar Caixa</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <div class="row g-2 mb-3">
          <div class="col-6 col-md-4">
            <div class="border rounded p-2">
              <div class="small text-muted">Entradas (esperado)</div>
              <div id="cc-expected-total" class="fw-bold">R$ 0,00</div>
            </div>
          </div>
          <div class="col-6 col-md-4">
            <div class="border rounded p-2">
              <div class="small text-muted">Despesas (lançadas)</div>
              <div id="cc-expenses-total" class="fw-bold">R$ 0,00</div>
            </div>
          </div>
          <div class="col-12 col-md-4">
            <div class="border rounded p-2">
              <div class="small text-muted">Resultado (E - D)</div>
              <div id="cc-result-expected" class="fw-bold">R$ 0,00</div>
            </div>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-striped align-middle mb-2">
            <thead>
              <tr>
                <th>Método</th>
                <th class="text-end">Esperado</th>
                <th style="width: 180px;">Contado</th>
                <th class="text-end">Diferença</th>
              </tr>
            </thead>
            <tbody id="cc-count-tbody"><!-- via JS --></tbody>
            <tfoot>
              <tr>
                <th>Total</th>
                <th class="text-end" id="cc-expected-sum">R$ 0,00</th>
                <th><input id="cc-counted-sum" type="text" class="form-control text-end text-dark bg-white" readonly></th>
                <th class="text-end" id="cc-diff-sum">R$ 0,00</th>
              </tr>
            </tfoot>
          </table>
        </div>

        <div id="cc-diff-alert" class="alert alert-warning d-none py-2 px-3">
          Existem diferenças entre o esperado e o contado. Revise antes de fechar.
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-dark btn-uniform" data-bs-dismiss="modal">Cancelar</button>
        <button id="cc-submit-btn" class="btn btn-danger btn-uniform">Fechar Caixa</button>
      </div>
    </div>
  </div>
</div>

<style>
  /* =========================================================
   TÍTULO
========================================================= */
#cashierTitle{
  color: var(--cashier-title-color,#fff) !important;
  font-weight: 600;
  letter-spacing: .2px;
}
@media (max-width:576.98px){
  #cashierTitle{ font-size:1.25rem; }
}

/* =========================================================
   MODAIS — z-index padrão + backdrop mais leve
   (mantém comportamento do Bootstrap e evita modal "travado")
========================================================= */
.modal{ z-index:1055; }
.modal-backdrop{ z-index:1050; }
.modal-backdrop.show{ opacity:.45; }

/* Neutraliza qualquer transform/filter que crie stacking-context
   quando um modal está aberto (evita modal ficar atrás / tela cinza) */
body.modal-open .fade-in-soft,
body.modal-open .admin-dashboard,
body.modal-open .container-fluid,
body.modal-open .row,
body.modal-open .col-12{
  transform:none !important;
  filter:none !important;
  perspective:none !important;
  will-change:auto !important;
}

/* Campos e botões nos modais (altura uniforme) */
#openCashierModal .input-group-text, #openCashierModal .form-control, #openCashierModal .form-select,
#expenseModal   .input-group-text,   #expenseModal   .form-control,   #expenseModal   .form-select,
#closeCashierModal .input-group-text,#closeCashierModal .form-control,#closeCashierModal .form-select{
  height:40px; padding:.5rem .65rem; font-size:.95rem; line-height:1.2;
  background:#fff !important; color:#212529 !important; border-color:#ced4da !important;
}
#openCashierModal .input-group-text,
#expenseModal   .input-group-text,
#closeCashierModal .input-group-text{ background:#f8f9fa !important; }

#openCashierModal .btn, #expenseModal .btn, #closeCashierModal .btn{
  padding:.5rem .9rem; font-size:.9rem; min-width:128px; line-height:1.2;
}
.btn-uniform{ padding:.5rem .9rem; font-size:.9rem; min-width:128px; line-height:1.2; }

/* =========================================================
   MODAL: FECHAR CAIXA (visual claro)
========================================================= */
#closeCashierModal{ --brand-primary: var(--primary-color, var(--bs-primary, #0d6efd)); }
#closeCashierModal .modal-content{ background:#fff !important; color:#212529 !important; }
#closeCashierModal .modal-header{ background:#dc3545 !important; color:#fff !important; }
#closeCashierModal .btn-close, #closeCashierModal .btn-close-white{ filter: invert(1); }
#closeCashierModal .text-muted{ color:#6c757d !important; }

#closeCashierModal .table thead tr{ background: var(--brand-primary) !important; }
#closeCashierModal .table thead th{ color:#fff !important; border-color: rgba(255,255,255,.25) !important; }
#closeCashierModal .table tbody tr, #closeCashierModal .table tfoot tr{ background: var(--brand-primary) !important; }
#closeCashierModal .table{
  --bs-table-color:#fff; --bs-table-striped-color:#fff; --bs-table-hover-color:#fff;
}
#closeCashierModal .table *:not(.form-control):not(.input-group-text){ color:#fff !important; opacity:1 !important; }
#closeCashierModal .table tbody td,
#closeCashierModal .table tfoot th,
#closeCashierModal .table tfoot td{ border-color: rgba(255,255,255,.15) !important; }
#closeCashierModal #cc-counted-sum{ text-align:right; background:#fff !important; color:#212529 !important; }

/* =========================================================
   AÇÕES DO TOPO
========================================================= */
.cashier-actions{ display:flex; flex-wrap:wrap; gap:.5rem; }
@media (min-width:577px){
  .cashier-actions .btn{
    display:inline-flex; align-items:center; justify-content:center;
    padding:.6rem 1rem; min-width:150px; font-size:.95rem; line-height:1.2;
  }
}

/* =========================================================
   CARD: HISTÓRICO (cores + responsivo)
========================================================= */
#cashierHistoryCard .card-header{ border-bottom:1px solid rgba(255,255,255,.075); }
#cashierHistoryCard .hist-w{ min-width:160px; }
#cashierHistoryCard .hist-pagesize{ width:84px; min-width:84px; }
#cashierHistoryCard .hist-range-group{ overflow-x:auto; white-space:nowrap; max-width:100%; }

@media (max-width:576.98px){
  #cashierHistoryCard .d-flex.flex-wrap.gap-2.align-items-center > *{ flex:1 1 100%; }
  #cashierHistoryCard .hist-w, #cashierHistoryCard .hist-pagesize{ width:100%; min-width:0; }
  #cashierHistoryCard .btn-group.hist-range-group{ width:100%; }
  #cashierHistoryCard .table{ font-size:.84rem; }
  #cashierHistoryCard .table>:not(caption)>*>*{ padding:.4rem .5rem; }
  #cashierHistoryCard .card-header{ position:sticky; top:56px; z-index:2; background:var(--bs-card-bg,#1e1e1e); }
}

#cashierHistoryCard{
  --hist-bg:var(--bg-light);
  --hist-surface:var(--bg-gray);
  --hist-border:var(--border-color);
  --hist-text:var(--text-dark);
  --hist-muted:#9ca3af;
  --hist-focus:var(--primary-color);
}
#cashierHistoryCard .card-header{ background:var(--hist-bg); border-bottom:1px solid var(--hist-border); }

#cashierHistoryCard .form-control.form-control-sm,
#cashierHistoryCard .form-select.form-select-sm{
  background:#1e1e22; border:1px solid var(--hist-border); color:var(--hist-text);
  height:38px; padding:.35rem .6rem;
}
#cashierHistoryCard .form-control::placeholder{ color:var(--hist-muted); opacity:.9; }
#cashierHistoryCard input[type="date"]::-webkit-calendar-picker-indicator{
  filter: invert(1) opacity(.9); cursor:pointer;
}

#cashierHistoryCard .hist-range-group .btn{
  background:#1e1e22; border:1px solid var(--hist-border); color:var(--hist-text);
}
#cashierHistoryCard .hist-range-group .btn:hover{ background:#232327; }
#cashierHistoryCard .hist-range-group .btn.active{
  background:var(--primary-color); border-color:var(--primary-color); color:#000;
}
#cashierHistoryCard .hist-pagesize{
  background:#1e1e22; border:1px solid var(--hist-border); color:var(--hist-text);
  height:38px; min-width:92px;
}
#cashierHistoryCard #histSearchBtn.btn{
  background:var(--primary-color); border:1px solid var(--primary-color);
  color:#000; height:38px; padding:.35rem .75rem;
}
#cashierHistoryCard #histSearchBtn.btn:hover{ filter:brightness(1.05); }

#cashierHistoryCard thead.table-light th{
  background:#202026 !important; color:var(--hist-text) !important; border-color:var(--hist-border) !important;
}
#cashierHistoryCard tbody td{ background:#18181c; border-color:var(--hist-border); }
#cashierHistoryCard tbody tr:hover td{ background:#1d1d22; }

#cashierHistoryCard .badge.bg-success{ background-color:#198754 !important; color:#fff !important; }

#cashierHistoryCard .card-body + .d-flex{
  background:var(--hist-bg); border-top:1px solid var(--hist-border);
}
#cashierHistoryCard .pagination .page-link{
  color:var(--primary-color); border-color:var(--primary-color); background:transparent;
}
#cashierHistoryCard .pagination .page-item.active .page-link{
  background:#fff; color:#000 !important; border-color:var(--primary-color);
}

/* Mobile: densidade */
@media (max-width:576.98px){
  #cashierHistoryCard{ font-size:12px; }
  #cashierHistoryCard .card-header strong{ font-size:.9rem; }
  #cashierHistoryCard .form-control.form-control-sm, #cashierHistoryCard .form-select.form-select-sm{
    height:32px; font-size:.8rem; padding:.25rem .5rem;
  }
  #cashierHistoryCard thead th{ font-size:.72rem; padding:.3rem .35rem; }
  #cashierHistoryCard .table>:not(caption)>*>*{ padding:.3rem .4rem; }
  #cashierHistoryCard tbody td.text-nowrap{
    max-width:120px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  }
  #cashierHistoryCard .badge{ font-size:.6rem; padding:.15rem .3rem; }
}

/* =========================================================
   MODAL: DETALHES DA SESSÃO — tema escuro legível
========================================================= */
#sessionDetailModal .modal-content{
  background:#1e1e22 !important;
  color:#fff !important;
}
#sessionDetailModal .modal-header{
  background:#2a2a30 !important;
  color:#fff !important;
  border-bottom: 1px solid rgba(255,255,255,.12) !important;
}
#sessionDetailModal .btn-close{ filter: invert(1); }

/* Cards/resumos do topo dentro do modal */
#sessionDetailModal .modal-body .border.rounded.p-2{
  background:#23232a !important;
  border-color: rgba(255,255,255,.15) !important;
}
#sessionDetailModal .modal-body .small.text-muted{
  color:#c8c8c8 !important;
}
#sessionDetailModal .modal-body .fw-bold{ color:#fff !important; }

/* Tabela dentro do modal */
#sessionDetailModal .table{ --bs-table-color:#fff; }
#sessionDetailModal thead tr{ background:#2f2f36 !important; }
#sessionDetailModal thead th{
  color:#fff !important; border-color: rgba(255,255,255,.18) !important;
}
#sessionDetailModal tbody td{
  background:#1f1f26 !important; color:#fff !important;
  border-color: rgba(255,255,255,.1) !important;
}
#sessionDetailModal tbody tr:hover td{ background:#24242c !important; }

/* Rodapé do modal */
#sessionDetailModal .modal-footer{
  background:#1b1b20 !important;
  border-top: 1px solid rgba(255,255,255,.08) !important;
}

/* Botão "Fechar" igual ao "Aplicar" (branco, texto preto, borda suave) */
#sessionDetailModal .modal-footer .btn.btn-secondary{
  background:#fff !important;
  color:#000 !important;
  border:1px solid #ced4da !important;
  border-radius:.375rem !important;
  font-weight:500;
  transition: background-color .15s ease, box-shadow .15s ease;
  box-shadow:none !important;
}
#sessionDetailModal .modal-footer .btn.btn-secondary:hover{
  background:#f8f9fa !important;
  border-color:#bdbdbd !important;
}
#sessionDetailModal .modal-footer .btn.btn-secondary:focus{
  box-shadow:0 0 0 .2rem rgba(108,117,125,.25) !important;
}

</style>


<script src="/js/cashier.js"></script>


<script>
  (function () {
    const ids = ['openCashierModal','expenseModal','closeCashierModal','sessionDetailModal'];

    ids.forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;

     
      el.addEventListener('show.bs.modal', (ev) => {
        if (ev.target.parentNode !== document.body) {
          document.body.appendChild(ev.target);
        }
      
        bootstrap.Modal.getOrCreateInstance(ev.target, { backdrop: true, keyboard: true });
      });

      
      el.addEventListener('hidden.bs.modal', () => {
        document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
        document.body.classList.remove('modal-open');
        document.body.style.removeProperty('paddingRight');
      });
    });
  })();
</script>

