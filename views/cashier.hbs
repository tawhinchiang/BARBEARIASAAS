    border-color: var(--hist-border);
  }
  #cashierHistoryCard #histFilters .hist-range-group .btn {
    background: #1e1e22;
    color: var(--hist-text);
    border-color: var(--hist-border);
  }
  #cashierHistoryCard .form-control.form-control-sm,
  #cashierHistoryCard .form-select.form-select-sm {
    height: 32px;
    font-size: .8rem;
    padding: .25rem .5rem;
  }
  #cashierHistoryCard .table {
    table-layout: fixed;
    width: 100%;
    font-size: .78rem;
  }
  #cashierHistoryCard thead th {
    font-size: .72rem;
    padding: .3rem .35rem;
  }
  #cashierHistoryCard .table>:not(caption)>*>* {
    padding: .28rem .35rem;
    line-height: 1.25;
    vertical-align: middle;
  }
  #cashierHistoryCard .text-nowrap {
    white-space: normal !important;
  }
  .cc-table {
    font-size: .78rem;
  }
  .cc-table thead th {
    font-size: .7rem;
  }
  .cc-table td {
    padding: .35rem .35rem;
  }
  .cc-table .input-group {
    max-width: 110px;
  }
  .cc-table .input-group-text {
    width: 30px;
    padding: .25rem .35rem;
  }
  .cc-table .form-control {
    height: 30px;
    font-size: .8rem;
  }
  .app-modal .modal-dialog {
    margin: calc(env(safe-area-inset-top, 0px) + 56px) auto 12px;
  }
}
</style>

<script src="/js/cashier.js"></script>


