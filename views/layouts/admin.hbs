<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0B0D12">
  <meta name="color-scheme" content="dark">
  <title>{{#if title}}{{title}} - {{/if}}Admin - {{barbershopName}}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">

  <meta name="description" content="Painel Administrativo - {{barbershopName}}">
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="{{adminFavicon}}" type="image/png">
</head>

<body class="admin-body" style="opacity:0; transition: opacity .2s ease;">
  <script>requestAnimationFrame(function(){ document.body.style.opacity='1'; });</script>

  {{#unless hideNavbar}}
  <header class="navbar navbar-dark fixed-top admin-navbar">
    <div class="container-fluid">
      <button id="sidebarToggle" class="navbar-toggler me-2" type="button" data-bs-toggle="offcanvas"
        data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Abrir menu">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="brand-compact d-flex align-items-center gap-2">
        <img src="{{BARBERSHOP_LOGO}}" alt="Logo" class="navbar-logo" loading="lazy" style="width:34px;height:34px;border-radius:10px;object-fit:cover;">
        <div class="title-stack">
          <div class="navbar-title fw-bold" style="color:var(--ink); line-height:1.1;">
            {{#if pageTitle}}{{pageTitle}}{{else}}{{title}}{{/if}}
          </div>
          {{#if pageSubtitle}}
          <small class="navbar-subtitle" style="color:var(--muted);">{{{pageSubtitle}}}</small>
          {{/if}}
        </div>
      </div>
      <div class="ms-auto d-flex align-items-center gap-2">
        <div id="whatsapp-status-toast" class="d-none d-md-flex">
          <span id="whatsapp-status-text"></span>
        </div>
        {{#if lastUpdate}}
        <small class="text-muted d-none d-md-inline">{{lastUpdate}}</small>
        {{/if}}
      </div>
    </div>
  </header>

  <div class="d-none d-lg-block">
    {{> adminSideDock user=user isBarber=isBarber}}
  </div>
  <div class="d-lg-none">
    {{> adminSidebar sidebarTitle=title user=user isBarber=isBarber}}
  </div>
  {{/unless}}



  <!-- Conteúdo principal -->
  <main class="admin-main">
    {{{body}}}
  </main>

  <!-- Footer administrativo -->
{{#unless hideFooter}}
<footer class="admin-footer py-3 mt-4 small">
  <div class="container-fluid ps-md-5">
    <div class="row align-items-center g-2 lh-sm">
      <div class="col-12 col-md">
        <span class="text-muted">© {{#if currentYear}}{{currentYear}}{{else}}2026{{/if}} <span class="fw-semibold" style="color:#8fb0ff;">{{barbershopName}}</span>. Gestão de barbearia.</span>
      </div>
      <div class="col-12 col-md-auto ms-md-auto">
        <div class="d-flex justify-content-md-end align-items-center gap-3 flex-wrap">
          <span class="text-muted"><i class="fa-solid fa-code-branch me-1" aria-hidden="true"></i>v{{#if appVersion}}{{appVersion}}{{else}}1.0.0{{/if}}</span>
          <a class="text-decoration-none" style="color:#73e8cf;" href="https://wa.me/5563992014547" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp me-1" aria-hidden="true"></i>Suporte</a>
        </div>
      </div>
    </div>
  </div>
</footer>
{{/unless}}


  <!-- Stack de Toasts (notificações) -->
  <div id="toastStack" class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 2000;"></div>

  <!-- Modal de Confirmação (reutilizável) -->
  <div class="modal fade" id="confirmDialogModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:440px">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="confirmDialogLabel">Confirmar ação</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body" id="confirmDialogMessage">Tem certeza?</div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" id="confirmDialogCancel" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-primary" id="confirmDialogOk">Confirmar</button>
        </div>
      </div>
    </div>
  </div>


  <!-- Bootstrap 5 JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Font Awesome JS -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>

  <!-- Chart.js (para gráficos) -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- Scripts administrativos -->
  <script src="/js/admin.js"></script>

  <!-- Script para atualizar horário -->
  {{#if isAuthenticated}}
  <script>
    // Remove alert de sucesso após 4s
    setTimeout(() => {
      const alert = document.querySelector('.alert-success');
      if (alert) alert.remove();
    }, 4000);

    // Atualiza relógio do rodapé
    function updateTime() {
      const now = new Date();
      const timeString = now.toLocaleTimeString('pt-BR');
      const timeElement = document.getElementById('currentTime');
      if (timeElement) timeElement.textContent = timeString;
    }
    setInterval(updateTime, 1000);
    updateTime();

    // Marca link ativo na sidebar
    document.addEventListener('DOMContentLoaded', function () {
      // se existir fade-in global, garanta que o body apareça
      requestAnimationFrame(() => document.body.style.opacity = '1');

      checkWhatsAppStatus();

      const currentPath = window.location.pathname;
      const links = document.querySelectorAll('.admin-menu .list-group-item');

      links.forEach(link => {
        const href = link.getAttribute('href');
        if (!href) return;
        if (currentPath === href || currentPath.startsWith(href + '/')) {
          link.classList.add('active');
        }
      });
    });

    // Fecha a Offcanvas e navega (sem duplicar handlers)
    document.addEventListener('DOMContentLoaded', () => {
      const sidebarEl = document.getElementById('adminSidebar');
      if (!sidebarEl || typeof bootstrap === 'undefined') return;
       if (window.innerWidth >= 992) return;
      const sidebar = bootstrap.Offcanvas.getOrCreateInstance(sidebarEl);

      sidebarEl.querySelectorAll('a[href]').forEach(a => {
        const href = a.getAttribute('href');
        const target = a.getAttribute('target');

        // 1) pula links externos/âncoras e os que abrem em nova aba
        if (!href || href.startsWith('http') || href.includes('#') || target === '_blank') return;

        a.addEventListener('click', (e) => {
          // 2) evita que outro listener global também intercepte
          e.preventDefault();
          e.stopImmediatePropagation();

          sidebar.hide();

          // pequeno delay para o offcanvas fechar sem travar o foco
          setTimeout(() => {
            if (typeof navigateWithFade === 'function') {
              navigateWithFade(href);
            } else {
              window.location.href = href;
            }
          }, 180);
        });
      });
    });

    // Status do WhatsApp (mantém os mesmos IDs que você já usa)
    async function checkWhatsAppStatus() {
      try {
        const toast = document.getElementById('whatsapp-status-toast');
        const text = document.getElementById('whatsapp-status-text');
        const inline = document.getElementById('whatsapp-status-inline');
        const inlineText = document.getElementById('whatsapp-status-text-inline');
        if (!toast || !text || !inline || !inlineText) return;

        toast.classList.remove('success', 'error', 'd-none', 'show');
        inline.classList.remove('success', 'error');

        const res = await fetch('/admin/whatsapp/status', { credentials: 'same-origin' });
        if (!res.ok) return;
        const data = await res.json();

        if (data.isConnected) {
          toast.classList.add('success', 'show');
          text.innerText = 'WhatsApp está conectado';
          setTimeout(() => toast.classList.remove('show'), 7000);
          inline.classList.add('success');
          inlineText.innerText = 'WhatsApp OK';
        } else {
          toast.classList.add('error', 'show');
          text.innerHTML = 'WhatsApp desconectado. <a href="/admin/config" class="text-danger fw-bold text-decoration-underline">Reconectar</a>';
          inline.classList.add('error');
          inlineText.innerText = 'WhatsApp off';
        }
      } catch (err) {
        console.error('[WHATSAPP STATUS ERROR]', err);
      }
    }
  </script>
  {{/if}}
</body>

</html>
