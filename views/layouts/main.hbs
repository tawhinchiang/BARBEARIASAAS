<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">

    {{!-- <meta http-equiv="Content-Security-Policy" content="
  default-src 'self';
  script-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://accounts.google.com 'unsafe-inline';
  style-src 'self' https://fonts.googleapis.com 'unsafe-inline';
  font-src 'self' https://fonts.gstatic.com;
  img-src 'self' data:;
  connect-src 'self';
"> --}}
    <title>{{#if title}}{{title}} - {{/if}}{{barbershopName}}</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- CSS Customizado -->
    <link rel="stylesheet" href="/css/style.css">
    
    <!-- Meta tags para SEO -->
    <meta name="description" content="Sistema de agendamento para barbearias - Agende seu corte online">
    <meta name="keywords" content="barbearia, agendamento, corte de cabelo, barba">
    <meta name="author" content="BarberShop">
    
    <!-- Favicon -->
  <link rel="icon" type="image/png" href="/images/logo.png">
    
    <!-- Google Sign-In -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>
</head>
<body class="client-body">
    {{{body}}}
    
    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Font Awesome JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    
    <!-- Scripts customizados -->
    {{#if isClientPage}}
    <script src="/js/app.js"></script>
    {{/if}}
    <!-- Stack de Toasts -->
<div id="toastStack" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:2000;"></div>

<!-- Modal de Confirmação -->
<div class="modal fade" id="confirmDialogModal" tabindex="-1" aria-labelledby="confirmDialogLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content border-0 shadow">
      <div class="modal-header">
        <h5 class="modal-title" id="confirmDialogLabel">Confirmar ação</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body" id="confirmDialogMessage">Tem certeza?</div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" id="confirmDialogCancel" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-primary" id="confirmDialogOk">Confirmar</button>
      </div>
    </div>
  </div>
</div>

<!-- UI util compartilhado -->
<script src="/js/ui.js"></script>

</body>
</html>

<style>
/* ===== ESTILOS PARA ÁREA DO CLIENTE ===== */

.client-body {
    background: var(--bg-light);
    color: var(--text-dark);
    font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    line-height: 1.6;
}

/* Garantir que o layout do cliente seja consistente */
.client-body .container,
.client-body .container-fluid {
    max-width: 1200px;
}

.client-body h1,
.client-body h2,
.client-body h3,
.client-body h4,
.client-body h5,
.client-body h6 {
    color: var(--text-dark);
    font-weight: 600;
}

.client-body p,
.client-body span,
.client-body div {
    color: var(--text-dark);
}

.client-body .text-muted {
    color: var(--text-muted) !important;
}

/* Botões do cliente */
.client-body .btn {
    border-radius: 8px;
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: all 0.3s ease;
}

.client-body .btn-primary {
    background: var(--primary-color);
    border-color: var(--primary-color);
    color: var(--text-light);
}

.client-body .btn-primary:hover {
    background: var(--secondary-color);
    border-color: var(--secondary-color);
    transform: translateY(-1px);
}

.client-body .btn-primary:disabled {
    background: var(--text-muted);
    border-color: var(--text-muted);
    transform: none;
}

.client-body .btn-secondary {
    background: var(--bg-light);
    border: 2px solid var(--border-color);
    color: var(--text-dark);
}

.client-body .btn-secondary:hover {
    border-color: var(--primary-color);
    background: var(--bg-gray);
}

/* Cards do cliente */
.client-body .card {
    border: 2px solid var(--border-color);
    border-radius: 12px;
    box-shadow: var(--shadow);
    background: var(--bg-light);
}

.client-body .card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-hover);
}

/* Formulários do cliente */
.client-body .form-control,
.client-body .form-select {
    border: 2px solid var(--border-color);
    border-radius: 8px;
    padding: 0.75rem;
    color: var(--text-dark);
    background: var(--bg-light);
}

.client-body .form-control:focus,
.client-body .form-select:focus {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.1);
}

.client-body .form-label {
    color: var(--text-dark);
    font-weight: 500;
}

/* Alertas do cliente */
.client-body .alert {
    border: none;
    border-radius: 8px;
    padding: 1rem;
}

.client-body .alert-success {
    background: #f0f9ff;
    color: var(--success-color);
    border-left: 4px solid var(--success-color);
}

.client-body .alert-danger {
    background: #fef2f2;
    color: var(--danger-color);
    border-left: 4px solid var(--danger-color);
}

.client-body .alert-warning {
    background: #fffbeb;
    color: #d97706;
    border-left: 4px solid var(--warning-color);
}

/* Links do cliente */
.client-body a {
    color: var(--primary-color);
    text-decoration: none;
    transition: color 0.3s ease;
}

.client-body a:hover {
    color: var(--secondary-color);
}

/* Responsividade para cliente */
@media (max-width: 768px) {
    .client-body .container {
        padding: 0 1rem;
    }
    
    .client-body h1 {
        font-size: 2rem;
    }
    
    .client-body .btn {
        padding: 0.75rem 1rem;
        font-size: 0.9rem;
    }
}
</style>

