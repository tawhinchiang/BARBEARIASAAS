<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
  <meta name="theme-color" content="#0B0D12">
  <meta name="color-scheme" content="dark">
  <title>{{#if title}}{{title}} - {{/if}}{{barbershopName}}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">

  {{#if isHistoryPage}}
  <script src="/js/history.js" defer></script>
  {{/if}}
  <meta name="description" content="{{barbershopName}} - agendamento online de serviços de barbearia">
  <link rel="icon" type="image/jpg" href="{{barbershopLogo}}">
  <script src="https://accounts.google.com/gsi/client" async defer></script>
</head>
<body class="client-body has-bottom-nav">
  <div id="pageWrapper">
    {{{body}}}
  </div>

  <nav class="bottom-barber-navbar enhanced-navbar" id="quickNav" aria-label="Navegação">
    <a href="/" class="nav-button" aria-label="Início">
      <i class="fa-solid fa-house" aria-hidden="true"></i>
      <span>Início</span>
    </a>
    <a href="/history" class="nav-button" aria-label="Histórico">
      <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
      <span>Histórico</span>
    </a>
  </nav>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  {{#if frontendConfigJson}}
  <script>
    window.BARBERSHOP_CONFIG = Object.assign({}, {{{frontendConfigJson}}}, { BARBERSHOP_LOGO: "{{BARBERSHOP_LOGO}}" });
  </script>
  {{/if}}
  {{#if isClientPage}}
  <script src="/js/app.js"></script>
  {{/if}}

  <div id="toastStack" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:2000;"></div>
  <div class="modal fade" id="confirmDialogModal" tabindex="-1" aria-labelledby="confirmDialogLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content border-0 shadow">
        <div class="modal-header">
          <h5 class="modal-title" id="confirmDialogLabel">Confirmar ação</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body" id="confirmDialogMessage">Tem certeza?</div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" id="confirmDialogCancel" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-primary" id="confirmDialogOk">Confirmar</button>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/ui.js"></script>
  <script>
    (function(){ var p = location.pathname.replace(/\/$/,'') || '/'; document.querySelectorAll('#quickNav .nav-button').forEach(function(a){ if((a.getAttribute('href')||'').replace(/\/$/,'')===p) a.classList.add('active'); }); })();
  </script>
</body>
</html>

<style>
/* ===== ESTILOS PARA ÁREA DO CLIENTE ===== */

.client-body {
    background: var(--bg-light);
    color: var(--text-dark);
    font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    line-height: 1.6;
}

/* Garantir que o layout do cliente seja consistente */
.client-body .container,
.client-body .container-fluid {
    max-width: 1200px;
}

.client-body h1,
.client-body h2,
.client-body h3,
.client-body h4,
.client-body h5,
.client-body h6 {
    color: var(--text-dark);
    font-weight: 600;
}

.client-body p,
.client-body span,
.client-body div {
    color: var(--text-dark);
}

.client-body .text-muted {
    color: var(--text-muted) !important;
}

/* Botões do cliente */
.client-body .btn {
    border-radius: 8px;
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    transition: all 0.3s ease;
}

.client-body .btn-primary {
    background: var(--primary-color);
    border-color: var(--primary-color);
    color: var(--text-light);
}

.client-body .btn-primary:hover {
    background: var(--secondary-color);
    border-color: var(--secondary-color);
    transform: translateY(-1px);
}

.client-body .btn-primary:disabled {
    background: var(--text-muted);
    border-color: var(--text-muted);
    transform: none;
}

.client-body .btn-secondary {
    background: var(--bg-light);
    border: 2px solid var(--border-color);
    color: var(--text-dark);
}

.client-body .btn-secondary:hover {
    border-color: var(--primary-color);
    background: var(--bg-gray);
}

/* Cards do cliente */
.client-body .card {
    border: 2px solid var(--border-color);
    border-radius: 12px;
    box-shadow: var(--shadow);
    background: var(--bg-light);
}

.client-body .card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-hover);
}

/* Formulários do cliente */
.client-body .form-control,
.client-body .form-select {
    border: 2px solid var(--border-color);
    border-radius: 8px;
    padding: 0.75rem;
    color: var(--text-dark);
    background: var(--bg-light);
}

.client-body .form-control:focus,
.client-body .form-select:focus {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.1);
}

.client-body .form-label {
    color: var(--text-dark);
    font-weight: 500;
}

/* Alertas do cliente */
.client-body .alert {
    border: none;
    border-radius: 8px;
    padding: 1rem;
}

.client-body .alert-success {
    background: #f0f9ff;
    color: var(--success-color);
    border-left: 4px solid var(--success-color);
}

.client-body .alert-danger {
    background: #fef2f2;
    color: var(--danger-color);
    border-left: 4px solid var(--danger-color);
}

.client-body .alert-warning {
    background: #fffbeb;
    color: #d97706;
    border-left: 4px solid var(--warning-color);
}

/* Links do cliente */
.client-body a {
    color: var(--primary-color);
    text-decoration: none;
    transition: color 0.3s ease;
}

.client-body a:hover {
    color: var(--secondary-color);
}

/* Responsividade para cliente */
@media (max-width: 768px) {
    .client-body .container {
        padding: 0 1rem;
    }
    
    .client-body h1 {
        font-size: 2rem;
    }
    
    .client-body .btn {
        padding: 0.75rem 1rem;
        font-size: 0.9rem;
    }
}
</style>

