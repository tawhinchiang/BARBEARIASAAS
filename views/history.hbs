}

.card-neon-red {
  border: 3px solid #ff4d4d !important;
  border-left-width: 6px !important;
  border-radius: 0.75rem !important;
  box-shadow: 0 0 12px rgba(255, 77, 77, 0.4);
}

.card-neon-blue {
  border: 3px solid #3399ff !important;
  border-left-width: 6px !important;
  border-radius: 0.75rem !important;
  box-shadow: 0 0 12px rgba(51, 153, 255, 0.4);
}
</style>


