  <!-- Etapa 2: Seleção de Barbeiro -->
  <div id="step2" class="step">
    <div class="container">
      <div class="text-center mb-5">
        <h1 class="display-4 fw-bold mb-3">Escolha seu Barbeiro</h1>
        <p class="lead">Selecione o profissional de sua preferência</p>
      </div>
      
      <div class="barbers-grid" id="barbersContainer">
        <!-- Barbeiros serão carregados dinamicamente -->
      </div>
      
      <div class="step-navigation">
        <button id="backToService" class="btn btn-secondary" onclick="goToStep(1)">
          <i class="fas fa-arrow-left"></i> Voltar
        </button>
        <div class="step-indicator">
          <div class="step-dot completed"></div>
          <div class="step-dot active"></div>
          <div class="step-dot"></div>
          <div class="step-dot"></div>
        </div>
        <button id="continueToDate" class="btn btn-primary" disabled onclick="goToStep(3)">
          Continuar <i class="fas fa-arrow-right"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Etapa 3: Seleção de Data e Horário -->
  <div id="step3" class="step">
    <div class="container">
      <div class="text-center mb-5">
        <h1 class="display-4 fw-bold mb-3">Escolha Data e Horário</h1>
        <p class="lead">Selecione quando deseja ser atendido</p>
      </div>
      
      <!-- Calendário -->
      <div class="calendar-container">
        <div class="calendar-header">
          <button id="prevMonth" class="calendar-nav">
            <i class="fas fa-chevron-left"></i>
          </button>
          <h3 id="calendarTitle" class="calendar-title"></h3>
          <button id="nextMonth" class="calendar-nav">
            <i class="fas fa-chevron-right"></i>
          </button>
        </div>
        
        <div class="calendar-grid" id="calendarGrid">
          <!-- Calendário será gerado dinamicamente -->
        </div>
      </div>
      
      <!-- Horários Disponíveis -->
      <div id="timesContainer" class="times-container" style="display: none;">
        <h4 class="mb-3">Horários Disponíveis</h4>
        <div class="times-grid" id="timeSlotsContainer">
          <!-- Horários serão carregados dinamicamente -->
        </div>
      </div>
      
      <div class="step-navigation">
        <button id="backToBarber" class="btn btn-secondary" onclick="goToStep(2)">
          <i class="fas fa-arrow-left"></i> Voltar
        </button>
        <div class="step-indicator">
          <div class="step-dot completed"></div>
          <div class="step-dot completed"></div>
          <div class="step-dot active"></div>
          <div class="step-dot"></div>
        </div>
        <button id="continueToConfirm" class="btn btn-primary" disabled onclick="goToStep(4)">
          Continuar <i class="fas fa-arrow-right"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Etapa 4: Dados do Cliente e Confirmação -->
  <div id="step4" class="step">
    <div class="container">
      <div class="text-center mb-5">
        <h1 class="display-4 fw-bold mb-3">Seus Dados</h1>
        <p class="lead">Preencha seus dados para finalizar o agendamento</p>
      </div>
      
      <div class="row">
        <div class="col-lg-6">
          <!-- Formulário de Dados -->
          <div class="client-form">
            <h4 class="mb-4">Informações Pessoais</h4>
            
            <div class="form-group">
              <label class="form-label">Nome *</label>
              <input type="text" id="clientFirstName" class="form-control" placeholder="Seu nome" required>
            </div>
            
            <div class="form-group">
              <label class="form-label">Sobrenome *</label>
              <input type="text" id="clientLastName" class="form-control" placeholder="Seu sobrenome" required>
            </div>
            
            <div class="form-group">
              <label class="form-label">Telefone *</label>
              <input type="tel" id="clientPhone" class="form-control" placeholder="(11) 99999-9999" required>
            </div>
            
            <div class="form-group">
              <label class="form-label">E-mail (opcional)</label>
              <input type="email" id="clientEmail" class="form-control" placeholder="seu@email.com">
            </div>
            
            <!-- Login com Google -->
            <div class="text-center">
              <p class="text-muted mb-2">ou</p>
              <button id="googleLogin" class="btn btn-secondary">
                <i class="fab fa-google"></i> Entrar com Google
              </button>
            </div>
          </div>
        </div>
        
        <div class="col-lg-6">
          <!-- Resumo do Agendamento -->
          <div class="booking-summary">
            <h4 class="mb-4">Resumo do Agendamento</h4>
            
            <div class="summary-item">
              <span class="summary-label">Serviço:</span>
              <span class="summary-value" id="summaryService">-</span>
            </div>
            
            <div class="summary-item">
              <span class="summary-label">Barbeiro:</span>
              <span class="summary-value" id="summaryBarber">-</span>
            </div>
            
            <div class="summary-item">
              <span class="summary-label">Data:</span>
              <span class="summary-value" id="summaryDate">-</span>
            </div>
            
            <div class="summary-item">
              <span class="summary-label">Horário:</span>
              <span class="summary-value" id="summaryTime">-</span>
            </div>
            
            <div class="summary-item">
              <span class="summary-label">Duração:</span>
              <span class="summary-value" id="summaryDuration">-</span>
            </div>
            
            <div class="summary-item">
              <span class="summary-label">Valor:</span>
              <span class="summary-value" id="summaryPrice">-</span>
            </div>
          </div>
        </div>
      </div>
      
      <div class="step-navigation">
        <button id="backToDate" class="btn btn-secondary" onclick="goToStep(3)">
          <i class="fas fa-arrow-left"></i> Voltar
        </button>
        <div class="step-indicator">
          <div class="step-dot completed"></div>
          <div class="step-dot completed"></div>
          <div class="step-dot completed"></div>
          <div class="step-dot active"></div>
        </div>
        <button id="confirmBooking" class="btn btn-success" onclick="confirmBooking()">
          Confirmar Agendamento <i class="fas fa-check"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Etapa 5: Confirmação Final -->
  <div id="step5" class="step">
    <div class="container">
      <div class="confirmation-card">
        <div class="confirmation-icon">
          <i class="fas fa-check-circle"></i>
        </div>
        
        <h2 class="mb-3">Agendamento Confirmado!</h2>
        <p class="lead mb-4">
          Seu agendamento foi realizado com sucesso. Em breve você receberá uma confirmação via WhatsApp.
        </p>
        
        <div class="booking-details mb-4">
          <h5 class="mb-3">Detalhes do Agendamento:</h5>
          <div class="row text-start">
            <div class="col-md-6">
              <p><strong>Serviço:</strong> <span id="finalService"></span></p>
              <p><strong>Barbeiro:</strong> <span id="finalBarber"></span></p>
              <p><strong>Data:</strong> <span id="finalDate"></span></p>
            </div>
            <div class="col-md-6">
              <p><strong>Horário:</strong> <span id="finalTime"></span></p>
              <p><strong>Cliente:</strong> <span id="finalClient"></span></p>
              <p><strong>Valor:</strong> <span id="finalPrice"></span></p>
            </div>
          </div>
        </div>
        
        <div class="d-flex gap-3 justify-content-center">
          {{!-- <button id="whatsappConfirm" class="btn whatsapp-btn" onclick="sendWhatsAppConfirmation()">
            <i class="fab fa-whatsapp"></i> Confirmar via WhatsApp
          </button> --}}
          <button id="newBooking" class="btn btn-secondary" onclick="location.reload()">
            <i class="fas fa-plus"></i> Novo Agendamento
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

