{{!-- Página de Agendamento inspirada no AppBarber --}}

<div class="container fade-in-soft py-4">

  <!-- 🔹 Cabeçalho do Estabelecimento -->
  {{!-- Cabeçalho --}}
  <div class="text-center mb-4">
    <img src="{{barbershopLogo}}" alt="Logo" class="rounded-circle mb-2"
        style="width:80px; height:80px; object-fit:cover;">
    <h3 class="text-light">{{barbershopName}}</h3>
    <p class="small text-muted">{{tagline}}</p>
  </div>

  <!-- STEP 1: Serviços -->
<!-- STEP 1: Serviços -->
<!-- STEP 1: Serviços -->
<div id="step1">
  <div class="mb-4">
    <h5 class="text-muted border-bottom pb-2 mb-3">Serviços</h5>

    <!-- 🔎 Campo de busca -->
    <div class="mb-3">
      <input type="text" id="searchInput" class="form-control"
             placeholder="Buscar serviços..." oninput="filterServices()">
    </div>

    <div id="servicesSpinner" class="loading-spinner">
      <i class="fas fa-spinner fa-spin"></i>
    </div>
    <div id="servicesContainer" ></div>
  </div>
</div>



   <!-- STEP 2: Profissionais -->
  <div id="step2" style="display:none;">
      <div class="mb-4" id="barbersContainerWrapper">
        <h5 class="text-muted border-bottom pb-2 mb-3">Profissionais</h5>
        <div id="barbersContainer" class="list-group"></div>
      </div>

      <!-- Botão voltar -->
      <div class="d-flex justify-content-start mt-3">
        <button class="btn btn-outline-light" onclick="goToStep(1)">
          <i class="fas fa-arrow-left me-1"></i> Voltar
        </button>
      </div>
  </div>


  <!-- STEP 3: Calendário -->
  <div id="step3" style="display:none;">
      <div id="calendarSection" class="mt-4">
        <h5 class="text-muted border-bottom pb-2 mb-3">Selecione a Data</h5>
        <div class="d-flex justify-content-between align-items-center mb-2">
          <button id="prevMonth" class="btn btn-outline-light btn-sm">&lt;</button>
          <div id="calendarTitle" class="fw-bold text-light"></div>
          <button id="nextMonth" class="btn btn-outline-light btn-sm">&gt;</button>
        </div>
        <div id="calendarGrid" class="calendar-grid"></div>
      </div>



        <!-- Botão voltar -->
      <div class="d-flex justify-content-start mt-3">
        <button class="btn btn-outline-light" onclick="goToStep(2)">
          <i class="fas fa-arrow-left me-1"></i> Voltar
        </button>
      </div>
  </div>

  <!-- STEP 4: Cliente + Resumo -->
  <div id="step4" style="display:none;">
    <div id="clientSection" class="mt-4">
      <h5 class="text-muted border-bottom pb-2 mb-3">Seus Dados</h5>
      <div class="mb-3">
        <input id="clientFirstName" type="text" class="form-control mb-2" placeholder="Nome">
        <input id="clientLastName" type="text" class="form-control mb-2" placeholder="Sobrenome">
        <input id="clientPhone" type="tel" class="form-control mb-2" placeholder="Telefone (WhatsApp)">
        <input id="clientEmail" type="email" class="form-control mb-2" placeholder="Email (opcional)">
      </div>

      <h5 class="text-muted border-bottom pb-2 mb-3">Resumo</h5>
      <ul class="list-group mb-3">
        <li class="list-group-item bg-dark text-light">Serviço: <span id="summaryService"></span></li>
        <li class="list-group-item bg-dark text-light">Barbeiro: <span id="summaryBarber"></span></li>
        <li class="list-group-item bg-dark text-light">Data: <span id="summaryDate"></span></li>
        <li class="list-group-item bg-dark text-light">Horário: <span id="summaryTime"></span></li>
        <li class="list-group-item bg-dark text-light">Duração: <span id="summaryDuration"></span></li>
        <li class="list-group-item bg-dark text-light">Preço: <span id="summaryPrice"></span></li>
      </ul>

     <button id="btnConfirmBooking"
        type="button"
        class="btn btn-success w-100 d-inline-flex align-items-center justify-content-center gap-2"
        onclick="confirmBooking(this)">
  <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
  <span class="btn-label">Confirmar agendamento</span>
</button>

    </div>
      <!-- Botão voltar -->
      <div class="d-flex justify-content-start mt-3">
        <button class="btn btn-outline-light" onclick="goToStep(3)">
          <i class="fas fa-arrow-left me-1"></i> Voltar
        </button>
      </div>
  </div>

  <!-- STEP 5: Confirmação Final -->
  <div id="step5" style="display:none;">
    <div id="finalSection" class="mt-4">
      <div class="card bg-dark text-light p-4 shadow rounded-4">
        <h4 class="mb-3">Agendamento Confirmado!</h4>
        <p><strong>Serviço:</strong> <span id="finalService"></span></p>
        <p><strong>Barbeiro:</strong> <span id="finalBarber"></span></p>
        <p><strong>Data:</strong> <span id="finalDate"></span></p>
        <p><strong>Horário:</strong> <span id="finalTime"></span></p>
        <p><strong>Cliente:</strong> <span id="finalClient"></span></p>
        <p><strong>Preço:</strong> <span id="finalPrice"></span></p>
      </div>
    </div>
  </div>

{{!-- Detalhes do Estabelecimento --}}
<div class="mb-4 mt-5">
  <h5 class="text-muted border-bottom pb-2 mb-3">Detalhes do Estabelecimento</h5>

  {{#if barbershopMapsLink}}
    <p>
      <i class="fas fa-map-marker-alt me-2"></i>
      <a href="{{barbershopMapsLink}}" class="text-decoration-none text-light" target="_blank" rel="noopener">
        {{barbershopAddress}}
      </a>
    </p>
  {{else}}
    <p><i class="fas fa-map-marker-alt me-2"></i>{{barbershopAddress}}</p>
  {{/if}}

  {{#if barbershopHours}}
    <p><i class="fas fa-clock me-2"></i>{{barbershopHours}}</p>
  {{/if}}
</div>

{{!-- Formas de Pagamento --}}
<div class="mb-4">
  <h5 class="text-muted border-bottom pb-2 mb-3">Formas de Pagamento</h5>
  <div class="d-flex flex-wrap gap-2">
    {{#if paymentMethods}}
      {{#each paymentMethods}}
        <span class="badge bg-secondary px-3 py-2">{{this}}</span>
      {{/each}}
    {{else}}
      {{!-- Fallback amigável, caso não configure no .env --}}
      <span class="badge bg-secondary px-3 py-2">Dinheiro</span>
      <span class="badge bg-secondary px-3 py-2">Cartão</span>
      <span class="badge bg-secondary px-3 py-2">PIX</span>
    {{/if}}
  </div>
</div>

 {{!-- Redes Sociais --}}
<div class="mb-4">
  <h5 class="text-muted border-bottom pb-2 mb-3">Redes Sociais</h5>
  <div class="d-flex gap-3">
    {{#if whatsappNumber}}
      <a href="https://wa.me/{{whatsappNumber}}" class="text-success" target="_blank" rel="noopener">
        <i class="fab fa-whatsapp fa-2x"></i>
      </a>
    {{/if}}
    {{#if instagramUrl}}
      <a href="{{instagramUrl}}" class="text-danger" target="_blank" rel="noopener">
        <i class="fab fa-instagram fa-2x"></i>
      </a>
    {{/if}}
    {{#if facebookUrl}}
      <a href="{{facebookUrl}}" class="text-light" target="_blank" rel="noopener">
        <i class="fab fa-facebook fa-2x"></i>
      </a>
    {{/if}}
  </div>
</div>

{{!-- Contato --}}
<div class="mb-5">
  <h5 class="text-muted border-bottom pb-2 mb-3">Contato</h5>
  {{#if contactPhone}}
    <p><i class="fas fa-phone-alt me-2"></i> {{contactPhone}}</p>
  {{/if}}
  {{#if contactEmail}}
    <p><i class="fas fa-envelope me-2"></i> {{contactEmail}}</p>
  {{/if}}
</div>
    <!-- Modal de horários -->
      <div id="meuModal" class="modal" style="display:none;">
        <div class="modal-content bg-dark text-light p-4 rounded-3">
          <h5 class="mb-3 text-center">Horários disponíveis</h5>
          <div id="loadingSpinner" class="text-center d-none">
            <div class="spinner-border text-primary" role="status"></div>
          </div>
          <div id="timesContainer" class="mt-3" style="display:none;">
            <div id="timeSlotsContainer" class="times-grid"></div>
          </div>
          <button class="btn btn-secondary mt-3 w-100" onclick="fecharModal()">Fechar</button>
        </div>
      </div>
{{!-- Rodapé --}}
<footer class="bg-dark text-center py-4 mt-5 border-top border-secondary">
  <img src="{{barbershopLogo}}" alt="Logo" style="width:60px; height:60px;"  class="rounded-circle mb-2"
        style="width:80px; height:80px; object-fit:cover;">
  <p class="small text-muted">{{tagline}}</p>

  <div class="d-flex justify-content-center gap-3 mb-3">
    <a href="/" class="text-light">Início</a>
    <a href="/history" class="text-light">Meus Agendamentos</a>
  </div>

  <div class="d-flex justify-content-center gap-3 mb-3">
    <a href="{{#if termsUrl}}{{termsUrl}}{{else}}#{{/if}}" class="text-muted small">Termos de uso</a>
    <a href="{{#if cookiesUrl}}{{cookiesUrl}}{{else}}#{{/if}}" class="text-muted small">Política de Cookies</a>
  </div>
</footer>
<nav class="bottom-barber-navbar" id="quickNav" aria-label="Navegação">
  <a href="/" class="nav-button">
    <i class="fa-solid fa-house"></i>
    <span>Início</span>
  </a>

  <a href="/history" class="nav-button">
    <i class="fa-solid fa-calendar-check"></i>
    <span>Histórico</span>
  </a>
</nav>