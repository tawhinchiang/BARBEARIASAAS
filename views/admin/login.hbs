<!-- PÁGINA DE LOGIN ADMINISTRATIVO - DESIGN CLEAN -->
<div class="admin-login-container">
  <div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center">
    <div class="row w-100 justify-content-center">
     
        <div class="admin-card">
          <div class="text-center mb-4">
            <div class="logo-icon mx-auto mb-3">A</div>
            <h3 class="fw-bold">Acesso Administrativo</h3>
            <p class="text-muted">Entre com suas credenciais</p>
          </div>
          
          {{#if error}}
          <div class="alert alert-danger" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            {{error}}
          </div>
          {{/if}}
          
          <form method="POST" action="/admin/login" id="loginForm">
            <div class="form-group">
              <label for="username" class="form-label">Usuário</label>
              <div class="input-group">
                <span class="input-group-text">
                  <i class="fas fa-user"></i>
                </span>
                <input type="text" class="form-control" id="username" name="username" required autocomplete="username">
              </div>
            </div>
            
            <div class="form-group">
              <label for="password" class="form-label">Senha</label>
              <div class="input-group">
                <span class="input-group-text">
                  <i class="fas fa-lock"></i>
                </span>
                <input type="password" class="form-control" id="password" name="password" required autocomplete="current-password">
                <button type="button" class="btn btn-outline-secondary" id="togglePassword">
                  <i class="fas fa-eye" id="toggleIcon"></i>
                </button>
              </div>
            </div>
            
            <button type="submit" class="btn btn-primary w-100 py-3 fw-semibold" id="loginBtn">
              <i class="fas fa-sign-in-alt me-2"></i>
              <span id="loginText">Entrar</span>
            </button>
          </form>
          
          <div class="text-center mt-4">
            <a href="/" class="text-decoration-none">
              <i class="fas fa-arrow-left me-1"></i>
              Voltar ao site
            </a>
          </div>
          
          
         
        </div>
      
    </div>
  </div>
</div>



<script>
document.addEventListener('DOMContentLoaded', function() {
  console.log('[ADMIN LOGIN] Página carregada');
  
  // Toggle de senha
  const togglePassword = document.getElementById('togglePassword');
  const passwordInput = document.getElementById('password');
  const toggleIcon = document.getElementById('toggleIcon');
  
  if (togglePassword && passwordInput && toggleIcon) {
    togglePassword.addEventListener('click', function() {
      const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
      passwordInput.setAttribute('type', type);
      
      if (type === 'password') {
        toggleIcon.className = 'fas fa-eye';
      } else {
        toggleIcon.className = 'fas fa-eye-slash';
      }
    });
  }
  
  // Formulário de login
    const loginForm = document.getElementById('loginForm');
  if (loginForm) {
    loginForm.addEventListener('submit', () => {
      document.body.classList.add('fade-out-soft');
    });
  }
  const loginBtn = document.getElementById('loginBtn');
  const loginText = document.getElementById('loginText');
  
  if (loginForm && loginBtn && loginText) {
    loginForm.addEventListener('submit', function(e) {
      console.log('[ADMIN LOGIN] Enviando formulário');
      
      // Mostrar loading
      loginBtn.disabled = true;
      loginText.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Entrando...';
      
      // Permitir envio do formulário
      setTimeout(() => {
        if (loginBtn.disabled) {
          // Se ainda estiver disabled após 5 segundos, reativar
          loginBtn.disabled = false;
          loginText.innerHTML = 'Entrar';
        }
      }, 5000);
    });
  }
  
  // Auto-focus no campo usuário
  const usernameInput = document.getElementById('username');
  if (usernameInput) {
    usernameInput.focus();
  }
  
  // Verificar se há erro na URL
  const urlParams = new URLSearchParams(window.location.search);
  const error = urlParams.get('error');
  if (error) {
    console.log('[ADMIN LOGIN] Erro detectado:', error);
  }
});
document.getElementById('loginForm')?.addEventListener('submit', () => {
  const loader = document.createElement('div');
  loader.className = 'global-loading';
  document.body.appendChild(loader);
});

</script>

