<style>
  /* --- Layout mobile (até tablets) --- */
  @media (max-width: 768px) {
    .admin-card .d-flex {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }

    .admin-card .btn {
      align-self: flex-start;
      width: 100%;
    }

    #filterForm .row.mt-3 {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    #filterForm .col-md-9 {
      margin-top: 0;
    }

    .admin-dashboard {
      overflow-y: auto;
      padding-bottom: 3rem;
    }

    /* Força tabela ocupar só largura da tela */
    .admin-table-wrapper table,
    .admin-table table {
      min-width: 100% !important;
      width: 100% !important;
      table-layout: fixed;
    }

    table.admin-table {
      display: block;
      border-collapse: collapse;
    }

    table.admin-table tbody {
      display: block;
      width: 100%;
    }

    /* Linha = horário + card lado a lado */
    table.admin-table tr {
      display: flex;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0.3rem;
      margin-bottom: 0.3rem;
      border: none;
      background: transparent;
      padding: 0;
      min-height: 32px;
    }

    /* Coluna do horário */
    table.admin-table td:first-child {
      flex: 0 0 42px;
      font-weight: bold;
      font-size: 0.7rem;
      color: #111;
      text-align: center;
      background: #f1f1f1;
      border-radius: 0.25rem 0 0 0.25rem;
      padding: 0.2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 32px;
    }

    /* Coluna do agendamento */
    table.admin-table td:not(:first-child) {
      flex: 1;
      border: none;
      background: transparent;
      padding: 0;
      display: flex;
      align-items: stretch;
      min-height: 32px;
    }

    /* Card dentro da célula → flexível, quebra quando necessário */
    table.admin-table td:not(:first-child) > div {
      flex: 1;
      display: flex;
      flex-wrap: wrap;        /* ✅ permite quebrar linhas */
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.25rem;
      border-radius: 0.25rem;
      padding: 0.3rem 0.4rem;
      font-size: 0.7rem;
      font-weight: 500;
      line-height: 1.3;
      max-width: 100%;

      white-space: normal;    /* ✅ permite quebra */
      overflow-wrap: break-word;

      min-height: 32px;
      box-sizing: border-box;
    }

    /* Livre */
    .slot-free {
      background: transparent;
      border: 1px solid #ccc;
    }

    /* Status → cores no fundo */
    .slot-confirmed   { background: #4e73df; color: #fff; }
    .slot-in_progress { background: #f6c23e; color: #000; }
    .slot-completed   { background: #1cc88a; color: #fff; }
    .slot-cancelled   { background: #e74a3b; color: #fff; }
    .slot-no_show     { background: #858796; color: #fff; }
    .slot-pending     { background: #36b9cc; color: #fff; }
  }

  /* Extra pequeno (iPhones menores) */
  @media (max-width: 576px) {
    .admin-table td:first-child {
      flex: 0 0 36px;
      font-size: 0.6rem;
      padding: 0.15rem;
    }

    table.admin-table td:not(:first-child) > div {
      font-size: 0.6rem;
      padding: 0.2rem 0.3rem;
    }
  }

  /* --- Desktop mantém tabela normal --- */
  @media (min-width: 769px) {
    .admin-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: auto; /* ✅ cada coluna se ajusta */
    }

    table.admin-table tr {
      display: table-row; /* ✅ volta ao comportamento normal */
    }

    table.admin-table td {
      display: table-cell;
      vertical-align: middle;
      padding: 0.5rem;
      white-space: normal;
      word-break: break-word; /* ✅ quebra nomes longos */
    }

    table.admin-table td > div {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap; /* ✅ permite quebrar */
    }
  }

  .admin-table-wrapper {
    overflow-x: auto;
    width: 100%;
  }

  /* Dropdown de ações */
  .actions-menu {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .actions-menu .js-toggle-actions {
    background: var(--bg-gray);
    border: none;
    padding: 6px 10px;
    border-radius: 4px;
    z-index: 2;
  }

  .actions-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    background: var(--bg-light);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    box-shadow: var(--shadow);
    min-width: 180px;
    white-space: nowrap;
    z-index: 9999;
  }

  .actions-dropdown .action-item {
    display: block;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    padding: 10px 15px;
    font-size: 0.9rem;
