<!-- PÁGINA DE GERENCIAMENTO DE AGENDAMENTOS - CORRIGIDA DESIGN CLEAN -->
<div class="admin-dashboard fade-in-soft">
  <div class="container-fluid">
    <!-- Header -->
  <div class="row mb-4">
        <div class="col-12">
          <div class="admin-card">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h2 class="fw-bold mb-1">Gerenciar Agendamentos</h2>
                <p class="text-muted mb-0">Visualize e gerencie todos os agendamentos</p>
              </div>
              <div>
                {{!-- <button class="btn btn-primary" onclick="exportAppointments()">
                  <i class="fas fa-download"></i> Exportar
                </button> --}}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Filtros Corrigidos -->
      <div class="row mb-4">
        <div class="col-12">
          <div class="admin-filters">
            <form id="filterForm">
              <div class="row">
                <div class="col-md-3">
                  <div class="filter-group">
                    <label class="form-label">Data Inicial</label>
                    <input type="date" name="startDate" id="startDate" class="form-control" value="{{filters.startDate}}">
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="filter-group">
                    <label class="form-label">Data Final</label>
                    <input type="date" name="endDate" id="endDate" class="form-control" value="{{filters.endDate}}">
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="filter-group">
                    <label class="form-label">Barbeiro</label>
                    <select class="form-control" name="barberId" id="barberId">
                      <option value="">Todos os barbeiros</option>
                      {{#each barbers}}
                      <option value="{{id}}" {{#eq ../filters.barberId id}}selected{{/eq}}>{{name}}</option>
                      {{/each}}
                    </select>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="filter-group">
                    <label class="form-label">Status</label>
                    <select name="status" id="statusFilter" class="form-control">
                      <option value="">Todos os status</option>
                      {{!-- <option value="pending" {{#eq filters.status 'pending'}}selected{{/eq}}>Pendente</option> --}}
                      <option value="confirmed" {{#eq filters.status 'confirmed'}}selected{{/eq}}>Confirmado</option>
                      {{!-- <option value="completed" {{#eq filters.status 'completed'}}selected{{/eq}}>Concluído</option> --}}
                      <option value="cancelled" {{#eq filters.status 'cancelled'}}selected{{/eq}}>Cancelado</option>
                    </select>
                  </div>
                </div>
              </div>
              <div class="row mt-3 align-items-center">
                <div class="col-md-3">
                  <select class="form-control" name="sort" id="sort">
                    <option value="">Ordenar por</option>
                    <option value="date_desc" {{#eq filters.sort 'date_desc'}}selected{{/eq}}>Data/Hora (Mais recente)</option>
                    <option value="date_asc" {{#eq filters.sort 'date_asc'}}selected{{/eq}}>Data/Hora (Mais antigo)</option>
                    <option value="value_desc" {{#eq filters.sort 'value_desc'}}selected{{/eq}}>Valor (Maior primeiro)</option>
                    <option value="value_asc" {{#eq filters.sort 'value_asc'}}selected{{/eq}}>Valor (Menor primeiro)</option>
                    <option value="barber_asc" {{#eq filters.sort 'barber_asc'}}selected{{/eq}}>Barbeiro (A-Z)</option>
                    <option value="barber_desc" {{#eq filters.sort 'barber_desc'}}selected{{/eq}}>Barbeiro (Z-A)</option>
                  </select>
                </div>

                <div class="col-md-9 d-flex">
                  <button type="submit" class="btn btn-primary me-2">
                    <i class="fas fa-filter"></i> Aplicar Filtros
                  </button>
                  <button type="button" class="btn btn-secondary" onclick="clearFilters()">
                    <i class="fas fa-times"></i> Limpar
                  </button>
                </div>
                
              </div>
            </form>
          </div>
        </div>
      </div>

    <!-- Tabela de Agendamentos -->
    <div class="row">
      <div class="col-12">
        <div class="admin-card">
        <div class="admin-table">
          <div class="admin-table-wrapper">
            {{#if appointments}}
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Cliente</th>
                    <th>Serviço</th>
                    <th>Barbeiro</th>
                    <th>Data/Hora</th>
                    <th>Status</th>
                    <th>Valor</th>
                    {{!-- <th>WhatsApp</th> --}}
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each appointments}}
                  
                  <tr>
                    <td>
                      <span class="fw-bold">#{{id}}</span>
                    </td>
                    <td>
                      <div class="d-flex align-items-center">
                        <div class="avatar-sm me-2">
                          {{substring client.firstName 0 1}}{{substring client.lastName 0 1}}
                        </div>
                        <div>
                          <div class="fw-semibold">{{client.firstName}} {{client.lastName}}</div>
                          <small class="text-muted">{{client.phone}}</small>
                        </div>
                      </div>
                    </td>
                    <td>
                      

                      <div class="fw-semibold">{{serviceType.name}}</div>
                     {{!-- <small class="text-muted">{{serviceType.duration}} {{formatCurrency serviceType.price}}</small> --}}

                    </td>
                    <td>
                      <div class="fw-semibold">{{barber.name}}</div>
                      <small class="text-muted">{{barber.specialties}}</small>
                    </td>
                    <td>
                      <div class="fw-semibold">{{appointmentDateFormatted}}</div>
                      <small class="text-muted">{{appointmentTimeFormatted}}</small>
                    </td>
                    <td>
                  <span class="status-badge status-{{status}}">
                    {{#if (eq status 'confirmed')}}Confirmado
                    {{!-- {{else if (eq status 'pending')}}Pendente --}}
                    {{else if (eq status 'cancelled')}}Cancelado
                    {{!-- {{else if (eq status 'completed')}}Concluído --}}
                    {{else}}Desconhecido
                    {{/if}}
                  </span>

                    </td>
                    <td>
                      <div class="fw-bold"> {{formatCurrency totalPrice}}</div>
                    </td>
                    {{!-- <td>
                      {{#if whatsappSent}}
                        <span class="badge bg-success">
                          <i class="fab fa-whatsapp"></i> Enviado
                        </span>
                      {{else}}
                        <span class="badge bg-warning">
                          <i class="fas fa-clock"></i> Pendente
                        </span>
                      {{/if}}
                    </td> --}}
                    <td>
                    <div class="actions-menu">
                      <button class="btn btn-sm btn-secondary js-toggle-actions" data-id="{{id}}">
                        <i class="fas fa-ellipsis-v"></i>
                      </button>
                      <div class="actions-dropdown" id="actions-{{id}}">
                        <button class="action-item js-view-appointment" data-id="{{id}}">
                          <i class="fas fa-eye"></i> Visualizar
                        </button>
                        <button class="action-item js-edit-appointment" data-id="{{id}}">
                          <i class="fas fa-edit"></i> Editar
                        </button>
                        {{#unless whatsappSent}}
                        <button class="action-item js-send-whatsapp" data-id="{{id}}">
                          <i class="fab fa-whatsapp"></i> Enviar WhatsApp
                        </button>
                        {{/unless}}
                        {{#eq status 'pending'}}
                        <button class="action-item js-confirm-appointment" data-id="{{id}}">
                          <i class="fas fa-check"></i> Confirmar
                        </button>
                        {{/eq}}
                        {{#eq status 'confirmed'}}
                        {{!-- <button class="action-item js-complete-appointment" data-id="{{id}}">
                          <i class="fas fa-check-circle"></i> Concluir
                        </button> --}}
                        {{/eq}}
                        <button class="action-item danger js-cancel-appointment" data-id="{{id}}">
                          <i class="fas fa-times"></i> Cancelar
                        </button>
                        {{!-- <button class="action-item danger js-delete-appointment" data-id="{{id}}">
                          <i class="fas fa-trash"></i> Excluir
                        </button> --}}
                      </div>
                    </div>
                  </td>
                  </tr>
                  {{/each}}
                </tbody>
              </table>
          </div>
            {{else}}
              <div class="text-center py-5">
                <div class="display-1 text-muted mb-3">
                  <i class="fas fa-calendar-times"></i>
                </div>
                <h5 class="text-muted">Nenhum agendamento encontrado</h5>
                <p class="text-muted">Ajuste os filtros ou aguarde novos agendamentos.</p>
              </div>
            {{/if}}
          </div>
        </div>
      </div>
    </div>

    <!-- Paginação -->
    {{#if pagination}}
    <div class="row mt-4">
      <div class="col-12">
        <nav aria-label="Paginação">
          <ul class="pagination justify-content-center">
            {{#if pagination.hasPrev}}
            <li class="page-item">
              <a class="page-link" href="?page={{pagination.prevPage}}&{{queryString}}">Anterior</a>
            </li>
            {{/if}}
            
            {{#each pagination.pages}}
            <li class="page-item {{#if active}}active{{/if}}">
              <a class="page-link" href="?page={{page}}&{{../queryString}}">{{page}}</a>
            </li>
            {{/each}}
            
            {{#if pagination.hasNext}}
            <li class="page-item">
              <a class="page-link" href="?page={{pagination.nextPage}}&{{queryString}}">Próximo</a>
            </li>
            {{/if}}
          </ul>
        </nav>
      </div>
    </div>
    {{/if}}
  </div>
</div>

<!-- Modal de Visualização -->
<div class="modal fade appointment-view-modal" id="viewModal" tabindex="-1" >
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Detalhes do Agendamento</h5>
         <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>

      </div>
      <div class="modal-body" id="modalContent">
        <!-- Conteúdo será carregado dinamicamente -->
      </div>
    </div>
  </div>
</div>
<!-- Modal de Edição -->
<div class="modal fade" id="editModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <form id="editAppointmentForm">
        <div class="modal-header">
          <h5 class="modal-title">Editar Agendamento</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
        <div id="edit-loading" class="d-flex justify-content-center align-items-center py-5" style="display: none;">


          <input type="hidden" name="id" id="edit-id">
          <div class="row">
            <div class="col-md-6">
              <label class="form-label">Nome</label>
              <input type="text" id="edit-client-name" class="form-control" disabled>
            </div>
            <div class="col-md-6">
              <label class="form-label">Telefone</label>
              <input type="text" id="edit-client-phone" class="form-control" disabled>
            </div>
            <div class="col-md-6 mt-3">
              <label class="form-label">Serviço</label>
              <select id="edit-service" class="form-control" required></select>
            </div>
            <div class="col-md-6 mt-3">
              <label class="form-label">Barbeiro</label>
              <select id="edit-barber" class="form-control" required></select>
            </div>
            <div class="col-md-6 mt-3">
              <label class="form-label">Data</label>
              <input type="date" id="edit-date" class="form-control" required>
            </div>
            <div class="col-md-6 mt-3">
              <label class="form-label">Horário</label>
              <input type="time" id="edit-time" class="form-control" required>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">Salvar Alterações</button>
        </div>
      </form>
    </div>
  </div>
</div>
<div id="global-loading" class="global-loading d-none">
  <div class="spinner-border text-light" role="status">
    <span class="visually-hidden">Carregando...</span>
  </div>
</div>

<style>
/* 1. Botão Exportar alinhado com título em telas pequenas */
@media (max-width: 768px) {
  .admin-card .d-flex {
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
  }

  .admin-card .btn {
    align-self: flex-start;
    width: 100%;
  }
}

/* 2. Dropdowns e campos de data não estouram layout */
.admin-filters {
  overflow-x: auto;
}

.admin-filters select,
.admin-filters input[type="date"] {
  max-width: 100%;
}

/* 3. Espaçamento entre filtros e ordenação em telas pequenas */
@media (max-width: 768px) {
  #filterForm .row.mt-3 {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  #filterForm .col-md-9 {
    margin-top: 0;
  }
}

/* 4. Scroll horizontal na tabela */
.admin-table {
  overflow-x: auto;
  padding-bottom: 1rem;
}

.admin-table table {
  min-width: 800px;
}

/* 5. Ações (menu de 3 pontos) responsivo e funcional */

.actions-menu {
  position: relative;
  display: flex;
  justify-content: center;
}

.actions-menu .js-toggle-actions {
  background: var(--bg-gray);
  border: none;
  padding: 6px 10px;
  border-radius: 4px;
  z-index: 2;
}

/* Dropdown flutuante e sem quebrar tabela */
.actions-dropdown {
  display: none;
  position: absolute;
  top: calc(100% + 4px);
  right: 0;
  background: var(--bg-light);
  border: 1px solid var(--border-color);
  border-radius: 6px;
  box-shadow: var(--shadow);
  min-width: 180px;
  white-space: nowrap;
  z-index: 9999;
}

.actions-dropdown .action-item {
  display: block;
  width: 100%;
  text-align: left;
  background: transparent;
  border: none;
  padding: 10px 15px;
  font-size: 0.9rem;
  color: var(--text-dark);
}

.actions-dropdown .action-item:hover {
  background-color: var(--bg-gray);
}

.actions-menu.show .actions-dropdown {
  display: block;
}
/* Responsivo para dropdown e tabela */
@media (max-width: 576px) {
  .admin-table table {
    font-size: 0.875rem;
  }

.actions-dropdown {
    min-width: 100%;
    max-width: 100vw;
    overflow-x: auto;
    overflow-y: auto;
    max-height: 60vh;
    left: auto;
    right: 0;
    position: absolute;
  }

  .actions-dropdown .action-item {
    font-size: 1rem;
    padding: 14px;
  }
}

/* Scroll vertical para dashboard em telas pequenas */
@media (max-width: 768px) {
  .admin-dashboard {
    overflow-y: auto;
    padding-bottom: 3rem;
  }
}

.admin-table-wrapper {
  overflow-x: auto;
  width: 100%;
}
.admin-table-wrapper table {
  min-width: 900px;
}
</style>



