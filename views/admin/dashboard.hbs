<!-- DASHBOARD ADMINISTRATIVO -->
<div class="admin-dashboard fade-in-soft">
  <div class="container-fluid">

    <!-- Header -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="admin-card">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h2 class="fw-bold mb-1">Dashboard Administrativo</h2>
              <p class="text-muted mb-0">Bem-vindo, {{user.username}}!</p>
            </div>
            <div class="text-end">
              <div>{{formatDate (new Date)}}</div>
              <small class="text-muted">Última atualização</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Cards de Estatísticas -->
    <div class="row mb-4 align-items-stretch">
      <div class="col-lg-3 col-md-6 mb-3 d-flex">
        <div class="admin-card text-center w-100">
          <div class="display-6 mb-2"><i class="fas fa-calendar-check"></i></div>
          <h3 class="fw-bold">{{todayAppointmentsCount }}</h3>
          <p class="text-muted mb-0">Agendamentos Hoje</p>
        </div>
      </div>

      <div class="col-lg-3 col-md-6 mb-3 d-flex">
        <div class="admin-card text-center w-100">
          <div class="display-6 mb-2"><i class="fas fa-dollar-sign"></i></div>
          <h3 class="fw-bold">{{formatCurrency monthlyRevenue}} </h3>
          <p class="text-muted mb-0">Receita do Mês</p>
      </div>
      </div>

      {{!-- <div class="col-lg-3 col-md-6 mb-3 d-flex">
        <div class="admin-card text-center w-100">
          <div class="display-6 mb-2"><i class="fas fa-users"></i></div>
          <h3 class="fw-bold">{{stats.totalClients}}</h3>
          <p class="text-muted mb-0">Clientes Ativos</p>
        </div>
      </div>

      <div class="col-lg-3 col-md-6 mb-3 d-flex">
        <div class="admin-card text-center w-100">
          <div class="display-6 mb-2"><i class="fas fa-cut"></i></div>
          <h3 class="fw-bold">{{stats.totalBarbers}}</h3>
          <p class="text-muted mb-0">Barbeiros Ativos</p>
        </div>
      </div>
    </div> --}}

    <!-- Agendamentos Recentes -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="admin-card">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0">Agendamentos de Hoje</h4>
            <a href="/admin/appointments" class="btn btn-primary btn-sm">
              <i class="fas fa-eye"></i> Ver Todos
            </a>
          </div>
          {{#if recentAppointments}} 
                <div class="admin-table">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Cliente</th>
                  <th>Serviço</th>
                  <th>Barbeiro</th>
                  <th>Horário</th>
                  <th>Status</th>
                  <th>Valor</th>
                </tr>
              </thead>
              <tbody>
                {{#each recentAppointments}}
                <tr>
                  <td>
                    <div class="d-flex align-items-center">
                      <div class="avatar-sm me-2">
                        {{substring client.firstName 0 1}}{{substring client.lastName 0 1}}
                      </div>
                      <div>
                        <div class="fw-semibold">{{client.firstName}} {{client.lastName}}</div>
                        <small class="text-muted">{{client.phone}}</small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <div class="fw-semibold">{{serviceType.name}}</div>
                    <small class="text-muted">{{serviceType.duration}} min</small>
                  </td>
                  <td>{{barber.name}}</td>
                  <td>
                    <div class="fw-semibold">{{formatTime appointmentTime}}</div>
                    <small class="text-muted">{{appointmentDateFormatted}}</small>

                  </td>
                  <td>
                    <span class="status-badge status-{{status}}">
                      {{#if (eq status 'confirmed')}}Confirmado
                      {{else if (eq status 'pending')}}Pendente
                      {{else if (eq status 'cancelled')}}Cancelado
                      {{else if (eq status 'completed')}}Concluído
                      {{else}}Desconhecido
                      {{/if}}
                    </span>
                  </td>
                  <td><strong>{{formatCurrency totalPrice}}</strong></td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
          {{else}}
          <div class="text-center py-5">
            <div class="display-1 text-muted mb-3">
              <i class="fas fa-calendar-times"></i>
            </div>
            <h5 class="text-muted">Nenhum agendamento para hoje</h5>
          </div>
          {{/if}}
        </div>
      </div>
    </div>

    <!-- Gráfico de Agendamentos -->
    <div class="row">
      <div class="col-lg-4 mb-4">
        <div class="admin-card">
          <h4 class="fw-bold mb-3">Receita dos últimos 7 dias</h4>
          <canvas id="appointmentsChart" height="300"></canvas>
        </div>
      </div>

      <div class="col-lg-8 mb-4">
        <div class="admin-card">
          <h4 class="fw-bold mb-4">Barbeiros Mais Solicitados</h4>
          {{#if topBarbers.length}}
          {{#each topBarbers}}
          <div class="ranking-item d-flex align-items-center mb-3">
            <div class="ranking-position me-3">
              <span class="badge bg-primary text-dark">{{add @index 1}}</span>
            </div>
            <div class="avatar-sm me-3">{{substring name 0 1}}</div>
            <div class="flex-grow-1">
              <div class="fw-semibold">{{name}}</div>
              <small class="text-muted">{{appointmentCount}} agendamentos</small>
            </div>
            <div class="text-end fw-bold">R$ {{formatCurrency totalRevenue}}</div>
          </div>
          {{/each}}
          {{else}}
          <div class="text-center py-4">
            <i class="fas fa-user-friends display-4 text-muted mb-2"></i>
            <p class="text-muted">Nenhum dado disponível</p>
          </div>
          {{/if}}
        </div>
      </div>
    </div>

    <!-- Serviços Mais Populares -->
    <div class="row">
      <div class="col-12">
        <div class="admin-card">
          <h4 class="fw-bold mb-4">Serviços Mais Populares</h4>
          {{#if topServices.length}}
          <div class="row">
            {{#each topServices}}
            <div class="col-lg-3 col-md-6 mb-3">
              <div class="service-stat-card">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <div>
                    <h6 class="fw-bold mb-1">{{name}}</h6>
                    <small class="text-muted">{{duration}}</small>
                  </div>
                  <div class="text-end">
                    <div class="fw-bold">{{appointmentCount}}</div>
                    <small class="text-muted">agendamentos</small>
                  </div>
                </div>
                <div class="progress mb-2" style="height: 6px;">
                  <div class="progress-bar bg-primary" style="width: {{percentage}}%"></div>
                </div>
                <div class="d-flex justify-content-between">
                  <small class="text-muted">R$ {{formatCurrency price}}</small>
                  <small class="fw-bold">R$ {{formatCurrency totalRevenue}}</small>
                </div>
              </div>
            </div>
            {{/each}}
          </div>
          {{else}}
          <div class="text-center py-4">
            <i class="fas fa-cut display-4 text-muted mb-2"></i>
            <p class="text-muted">Sem dados de serviços</p>
          </div>
          {{/if}}
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Chart.js + Scripts -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // === Gráfico Chart.js ===
    const chartEl = document.getElementById('appointmentsChart');
    if (chartEl) {
      new Chart(chartEl, {
        type: 'line',
        data: {
          labels: {{{json revenueChartLabels}}},
          datasets: [{
            label: 'Receita (R$)',
            data: {{{json revenueChartData}}},
            backgroundColor: 'rgba(0, 123, 255, 0.2)',
            borderColor: '#007bff',
            pointBackgroundColor: '#007bff',
            pointRadius: 5,
            pointHoverRadius: 7,
            borderWidth: 2,
            fill: true,
            tension: 0.3
          }]
        },
        options: {
          responsive: true,
          plugins: {
            title: {
              display: true,
              text: 'Receita Confirmada por Dia da Semana'
            },
            legend: {
              labels: { font: { size: 14 } }
            },
            tooltip: {
              bodyFont: { size: 14 },
              titleFont: { size: 16 }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: { font: { size: 13 } }
            },
            x: {
              ticks: { font: { size: 13 } }
            }
          }
        },
        plugins: [{
          id: 'showCanvas',
          afterRender(chart) {
            const chartEl = chart.canvas;
            chartEl.style.visibility = 'visible';
            chartEl.style.opacity = '1';
          }
        }]
      });
    }

    // === Transição Suave da Página ===
    const dashboardEl = document.querySelector('.fade-in-soft');
    if (dashboardEl) {
      dashboardEl.addEventListener('animationend', () => {
        dashboardEl.classList.remove('fade-in-soft');
        dashboardEl.style.opacity = '1'; // Garante permanência após a animação
      });
    }
  });
</script>




<style>
.service-stat-card {
  background: var(--bg-light);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 1.5rem;
  transition: all 0.3s ease;
}
.service-stat-card:hover {
  border-color: var(--primary-color);
  transform: translateY(-2px);
  box-shadow: var(--shadow-hover);
}
.progress {
  background: var(--bg-gray);
}
.ranking-position .badge {
  width: 25px;
  height: 25px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

</style>
