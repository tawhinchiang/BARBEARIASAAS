<!-- DASHBOARD ADMINISTRATIVO CORRIGIDO - DESIGN CLEAN -->
<div class="admin-dashboard">
  <div class="container-fluid">
    <!-- Header do Dashboard -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="admin-card">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h2 class="fw-bold mb-1">Dashboard Administrativo</h2>
              <p class="text-muted mb-0">Bem-vindo, {{user.username}}!</p>
            </div>
            <div class="text-end">
              <div>{{formatDate (new Date)}}</div>
              <small class="text-muted">Última atualização</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Cards de Estatísticas -->
    <div class="row mb-4">
      <div class="col-lg-3 col-md-6 mb-3">
        <div class="admin-card text-center">
          <div class="display-6 mb-2">
            <i class="fas fa-calendar-check"></i>
          </div>
          <h3 class="fw-bold">{{stats.totalAppointments}}</h3>
          <p class="text-muted mb-0">Agendamentos Hoje</p>
        </div>
      </div>
      
      <div class="col-lg-3 col-md-6 mb-3">
        <div class="admin-card text-center">
          <div class="display-6 mb-2">
            <i class="fas fa-dollar-sign"></i>
          </div>
          <h3 class="fw-bold">R$ {{formatCurrency stats.totalRevenue}}</h3>
          <p class="text-muted mb-0">Receita do Mês</p>
        </div>
      </div>
      
      <div class="col-lg-3 col-md-6 mb-3">
        <div class="admin-card text-center">
          <div class="display-6 mb-2">
            <i class="fas fa-users"></i>
          </div>
          <h3 class="fw-bold">{{stats.totalClients}}</h3>
          <p class="text-muted mb-0">Clientes Ativos</p>
        </div>
      </div>
      
      <div class="col-lg-3 col-md-6 mb-3">
        <div class="admin-card text-center">
          <div class="display-6 mb-2">
            <i class="fas fa-cut"></i>
          </div>
          <h3 class="fw-bold">{{stats.totalBarbers}}</h3>
          <p class="text-muted mb-0">Barbeiros Ativos</p>
        </div>
      </div>
    </div>

    <!-- Agendamentos Recentes -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="admin-card">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0">Agendamentos de Hoje</h4>
            <a href="/admin/appointments" class="btn btn-primary btn-sm">
              <i class="fas fa-eye"></i> Ver Todos
            </a>
          </div>
          
          {{#if recentAppointments}}
            <div class="admin-table">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Cliente</th>
                    <th>Serviço</th>
                    <th>Barbeiro</th>
                    <th>Horário</th>
                    <th>Status</th>
                    <th>Valor</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each recentAppointments}}
                  <tr>
                    <td>
                      <div class="d-flex align-items-center">
                        <div class="avatar-sm me-2">
                          {{substring Client.firstName 0 1}}{{substring Client.lastName 0 1}}
                        </div>
                        <div>
                          <div class="fw-semibold">{{Client.firstName}} {{Client.lastName}}</div>
                          <small class="text-muted">{{Client.phone}}</small>
                        </div>
                      </div>
                    </td>
                    <td>
                      <div class="fw-semibold">{{ServiceType.name}}</div>
                      <small class="text-muted">{{ServiceType.duration}}</small>
                    </td>
                    <td>
                      <div class="fw-semibold">{{Barber.name}}</div>
                    </td>
                    <td>
                      <div class="fw-semibold">{{formatTime appointmentTime}}</div>
                      <small class="text-muted">{{formatDate appointmentDate}}</small>
                    </td>
                    <td>
                      <span class="status-badge status-{{status}}">
                        {{#eq status 'confirmed'}}Confirmado{{/eq}}
                        {{#eq status 'pending'}}Pendente{{/eq}}
                        {{#eq status 'cancelled'}}Cancelado{{/eq}}
                        {{#eq status 'completed'}}Concluído{{/eq}}
                      </span>
                    </td>
                    <td>
                      <div class="fw-bold">R$ {{formatCurrency totalPrice}}</div>
                    </td>
                  </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else}}
            <div class="text-center py-5">
              <div class="display-1 text-muted mb-3">
                <i class="fas fa-calendar-times"></i>
              </div>
              <h5 class="text-muted">Nenhum agendamento para hoje</h5>
              <p class="text-muted">Os agendamentos aparecerão aqui quando forem criados.</p>
            </div>
          {{/if}}
        </div>
      </div>
    </div>

    <!-- Gráficos e Métricas -->
    <div class="row">
      <div class="col-lg-8 mb-4">
        <div class="admin-card">
          <h4 class="fw-bold mb-4">Agendamentos por Dia (Últimos 7 dias)</h4>
          <div id="appointmentsChart" style="height: 300px;">
            <div class="d-flex align-items-center justify-content-center h-100">
              <div class="text-center">
                <div class="display-4 text-muted mb-3">
                  <i class="fas fa-chart-line"></i>
                </div>
                <p class="text-muted">Gráfico de agendamentos</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-lg-4 mb-4">
        <div class="admin-card">
          <h4 class="fw-bold mb-4">Barbeiros Mais Solicitados</h4>
          
          {{#if topBarbers}}
            <div class="barber-ranking">
              {{#each topBarbers}}
              <div class="ranking-item d-flex align-items-center mb-3">
                <div class="ranking-position me-3">
                  <span class="badge bg-dark">{{@index}}</span>
                </div>
                <div class="avatar-sm me-3">
                  {{substring name 0 1}}
                </div>
                <div class="flex-grow-1">
                  <div class="fw-semibold">{{name}}</div>
                  <small class="text-muted">{{appointmentCount}} agendamentos</small>
                </div>
                <div class="text-end">
                  <div class="fw-bold">R$ {{formatCurrency totalRevenue}}</div>
                </div>
              </div>
              {{/each}}
            </div>
          {{else}}
            <div class="text-center py-4">
              <div class="display-4 text-muted mb-3">
                <i class="fas fa-user-friends"></i>
              </div>
              <p class="text-muted">Dados aparecerão com agendamentos</p>
            </div>
          {{/if}}
        </div>
      </div>
    </div>

    <!-- Serviços Mais Populares -->
    <div class="row">
      <div class="col-12">
        <div class="admin-card">
          <h4 class="fw-bold mb-4">Serviços Mais Populares</h4>
          
          {{#if topServices}}
            <div class="row">
              {{#each topServices}}
              <div class="col-lg-3 col-md-6 mb-3">
                <div class="service-stat-card">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                      <h6 class="fw-bold mb-1">{{name}}</h6>
                      <small class="text-muted">{{duration}}</small>
                    </div>
                    <div class="text-end">
                      <div class="fw-bold">{{appointmentCount}}</div>
                      <small class="text-muted">agendamentos</small>
                    </div>
                  </div>
                  <div class="progress mb-2" style="height: 6px;">
                    <div class="progress-bar bg-dark" style="width: {{percentage}}%"></div>
                  </div>
                  <div class="d-flex justify-content-between">
                    <small class="text-muted">R$ {{formatCurrency price}}</small>
                    <small class="fw-bold">R$ {{formatCurrency totalRevenue}}</small>
                  </div>
                </div>
              </div>
              {{/each}}
            </div>
          {{else}}
            <div class="text-center py-4">
              <div class="display-4 text-muted mb-3">
                <i class="fas fa-cut"></i>
              </div>
              <p class="text-muted">Estatísticas aparecerão com agendamentos</p>
            </div>
          {{/if}}
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Estilos adicionais para o dashboard -->
<style>
.service-stat-card {
  background: var(--bg-light);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 1.5rem;
  transition: all 0.3s ease;
}

.service-stat-card:hover {
  border-color: var(--primary-color);
  transform: translateY(-2px);
  box-shadow: var(--shadow-hover);
}

.progress {
  background: var(--bg-gray);
}

.ranking-position .badge {
  width: 25px;
  height: 25px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
</style>

<script>
// Inicializar dashboard
document.addEventListener('DOMContentLoaded', function() {
  console.log('[ADMIN] Dashboard carregado');
  
  // Atualizar dados em tempo real (opcional)
  setInterval(function() {
    // Aqui você pode adicionar código para atualizar estatísticas em tempo real
  }, 30000); // Atualizar a cada 30 segundos
});
</script>

