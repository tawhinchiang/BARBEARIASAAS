{{!-- admin/barbers.hbs --}}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">
    <i class="fas fa-user-tie me-2"></i> Gerenciar Barbeiros
  </h2>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#barberModal">
    <i class="fas fa-plus me-2"></i> Novo Barbeiro
  </button>
</div>
<!-- Filtros Rápidos -->
<div class="row mb-4 align-items-end">
  <div class="col-md-4">
    <input type="text" class="form-control" id="filterSearch" placeholder="Buscar por nome, telefone ou CPF">
  </div>
  <div class="col-md-3">
    <select class="form-select" id="filterStatus">
      <option value="">Status</option>
      <option value="ativo">Ativo</option>
      <option value="inativo">Inativo</option>
    </select>
  </div>
  <div class="col-md-3">
    <input type="text" class="form-control" id="filterSpecialty" placeholder="Especialidade">
  </div>
</div>
{{#if error}}
<div class="alert alert-danger">
  <i class="fas fa-exclamation-triangle me-2"></i>
  {{error}}
</div>
{{/if}}

<div class="row mb-4" id="barbersContainer">
  {{#each barbers}}
  <div class="col-md-6 col-lg-4 barber-card" data-id="{{id}}" data-name="{{name}}" data-phone="{{phone}}" data-cpf="{{cpf}}" data-specialties="{{specialties}}" data-status="{{#if isActive}}ativo{{else}}inativo{{/if}}">
    <div class="card h-100 shadow-sm">
      <div class="card-body">
        <div class="d-flex align-items-center mb-3">
          {{#if photo}}
          <img src="{{photo}}" alt="{{name}}" class="rounded-circle me-3" width="50" height="50">
          {{else}}
          <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
            <i class="fas fa-user text-white"></i>
          </div>
          {{/if}}
          <div>
            <h5 class="card-title mb-0">{{name}}</h5>
            <small class="text-muted">{{phone}}</small>
          </div>
        </div>

        <p class="mb-1"><strong>CPF:</strong> <code>{{cpf}}</code></p>
        <p class="mb-1"><strong>Email:</strong> {{email}}</p>
        <p class="mb-1"><strong>Especialidades:</strong> {{specialties}}</p>
        <p class="mb-1"><strong>Horário:</strong> {{workingHours}}</p>

        <p class="mb-1"><strong>Status:</strong>
          {{#if isActive}}
            <span class="badge bg-success">Ativo</span>
          {{else}}
            <span class="badge bg-secondary">Inativo</span>
          {{/if}}
        </p>

        <p class="mb-3"><strong>Agendamentos:</strong>
          <span class="badge bg-primary">{{appointmentsThisMonth}}</span>
          <small class="text-muted">este mês</small>
        </p>

        <div class="d-flex justify-content-between">
          <button class="btn btn-sm btn-outline-primary" onclick="editBarber({{id}})">
            <i class="fas fa-edit"></i>
          </button>
          <button class="btn btn-sm btn-outline-info" onclick="barberReport({{id}})">
            <i class="fas fa-chart-bar"></i>
          </button>
          <button class="btn btn-sm btn-outline-{{#if isActive}}secondary{{else}}success{{/if}}" onclick="toggleBarber({{id}})">
            <i class="fas fa-{{#if isActive}}pause{{else}}play{{/if}}"></i>
          </button>
          <button class="btn btn-sm btn-outline-danger" onclick="deleteBarber({{id}})">
            <i class="fas fa-trash"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
  {{/each}}
</div>




<!-- Modal de Criar/Editar Barbeiro -->
<div class="modal fade" id="barberModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form id="barberForm" enctype="multipart/form-data">
        <div class="modal-header">
          <h5 class="modal-title" id="barberModalTitle">Novo Barbeiro</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="barberId" name="barberId">

          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="barberName" class="form-label">Nome *</label>
              <input type="text" class="form-control" id="barberName" name="name" placeholder="Nome completo" required>
            </div>
            <div class="col-md-6 mb-3">
              <label for="barberPhone" class="form-label">Telefone *</label>
              <input type="tel" class="form-control" id="barberPhone" name="phone" placeholder="(00) 00000-0000" required>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="barberEmail" class="form-label">Email</label>
              <input type="email" class="form-control" id="barberEmail" name="email" placeholder="email@exemplo.com">
            </div>
            <div class="col-md-6 mb-3">
              <label for="barberCpf" class="form-label">CPF *</label>
              <input type="text" class="form-control" id="barberCpf" name="cpf" placeholder="000.000.000-00" required>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="barberSpecialties" class="form-label">Especialidades</label>
              <input type="text" class="form-control" id="barberSpecialties" name="specialties" placeholder="Cortes, barba, pintura...">
            </div>
            <div class="col-md-6 mb-3">
              <label for="barberWorkingHours" class="form-label">Horário de Trabalho</label>
              <input type="text" class="form-control" id="barberWorkingHours" name="workingHours" placeholder="Ex: 09:00 - 18:00">
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="barberPhoto" class="form-label">Foto</label>
              <input type="file" class="form-control" id="barberPhoto" name="photo" accept="image/*">
            </div>
            <div class="col-md-6 d-flex align-items-center">
              <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" id="barberIsActive" name="isActive" checked>
                <label class="form-check-label" for="barberIsActive">Ativo</label>
              </div>
            </div>
          </div>

          <div id="photoPreview" class="mb-3 d-none">
            <label class="form-label">Preview:</label>
            <div>
              <img id="photoPreviewImg" src="" alt="Preview" class="rounded" style="max-width: 200px; max-height: 200px;">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-2"></i> Salvar
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="/css/style.css" rel="stylesheet">
<script src="/js/barbers.js"></script>
