<div class="modal fade" id="barberModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
   <div class="modal-content">
      <form id="barberForm" enctype="multipart/form-data">
        <div class="modal-header">
          <h5 class="modal-title" id="barberModalTitle">Novo Barbeiro</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          
          <input type="hidden" id="barberId" name="barberId">

          <div class="row">
           <div class="col-12 col-md-6 mb-3">

              <label for="barberName" class="form-label">Nome *</label>
              <input type="text" class="form-control" id="barberName" name="name" placeholder="Nome completo" required>
            </div>
            <div class="col-12 col-md-6 mb-3">

              <label for="barberPhone" class="form-label">Telefone *</label>
              <input type="tel" class="form-control" id="barberPhone" name="phone" placeholder="(00) 00000-0000" required>
            </div>
          </div>

          <div class="row">
            <div class="col-12 col-md-6 mb-3">

              <label for="barberEmail" class="form-label">Email</label>
              <input type="email" class="form-control" id="barberEmail" name="email" placeholder="email@exemplo.com">
            </div>
            <div class="col-12 col-md-6 mb-3">

              <label for="barberCpf" class="form-label">CPF *</label>
              <input type="text" class="form-control" id="barberCpf" name="cpf" placeholder="000.000.000-00" required>
            </div>
          </div>

          <div class="row">
           <div class="col-12 col-md-6 mb-3">

              <label for="barberSpecialties" class="form-label">Especialidades</label>
              <input type="text" class="form-control" id="barberSpecialties" name="specialties" placeholder="Cortes, barba, pintura...">
            </div>
              <div class="col-md-12 mb-3">
                <label class="form-label">Horários de Trabalho</label>
              <div class="row mb-2">
                <div class="col-md-6">
                  <input type="text" id="defaultWorkingHour" class="form-control" placeholder="Ex: 09:00-19:40">
                </div>
                <div class="col-md-6 text-end">
                  <button type="button" class="btn btn-outline-secondary" onclick="applyDefaultWorkingHour()">
                    <i class="fas fa-clock me-1"></i> Aplicar horário padrão
                  </button>
                </div>
              </div>


                <div class="row g-2">
                  <div class="col-md-4">
                    <label for="workingHoursMonday" class="form-label">Segunda-feira</label>
                    <input type="text" class="form-control" id="workingHoursMonday" name="workingHours[monday]" placeholder="Ex: 09:00-18:00">
                  </div>
                  <div class="col-md-4">
                    <label for="workingHoursTuesday" class="form-label">Terça-feira</label>
                    <input type="text" class="form-control" id="workingHoursTuesday" name="workingHours[tuesday]" placeholder="Ex: 09:00-18:00">
                  </div>
                  <div class="col-md-4">
                    <label for="workingHoursWednesday" class="form-label">Quarta-feira</label>
                    <input type="text" class="form-control" id="workingHoursWednesday" name="workingHours[wednesday]" placeholder="Ex: 09:00-18:00">
                  </div>
                  <div class="col-md-4">
                    <label for="workingHoursThursday" class="form-label">Quinta-feira</label>
                    <input type="text" class="form-control" id="workingHoursThursday" name="workingHours[thursday]" placeholder="Ex: 09:00-18:00">
                  </div>
                  <div class="col-md-4">
                    <label for="workingHoursFriday" class="form-label">Sexta-feira</label>
                    <input type="text" class="form-control" id="workingHoursFriday" name="workingHours[friday]" placeholder="Ex: 09:00-18:00">
                  </div>
                  <div class="col-md-4">
                    <label for="workingHoursSaturday" class="form-label">Sábado</label>
                    <input type="text" class="form-control" id="workingHoursSaturday" name="workingHours[saturday]" placeholder="Ex: 09:00-13:00">
                  </div>
                </div>
              </div> 

          </div>

          <div class="row">
            <div class="col-12 col-md-6 mb-3">

              <label for="barberPhoto" class="form-label">Foto</label>
              <input type="file" class="form-control" id="barberPhoto" name="photo" accept="image/*">
            </div>
            <div class="col-md-6 d-flex align-items-center">
              <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" id="barberIsActive" name="isActive" checked>
                <label class="form-check-label" for="barberIsActive">Ativo</label>
              </div>
            </div>
          </div>

          <div id="photoPreview" class="mb-3 d-none">
            <label class="form-label">Preview:</label>
            <div>
              <img id="photoPreviewImg" src="" alt="Preview" class="rounded" style="max-width: 200px; max-height: 200px;">
            </div>
          </div>

        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-2"></i> Salvar
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
<!-- Modal de Relatório do Barbeiro -->
<div class="modal fade" id="reportModal" tabindex="-1" aria-labelledby="reportModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content bg-dark text-white">
      <div class="modal-header">
        <h5 class="modal-title" id="reportModalLabel">Relatório do Barbeiro</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body" id="reportContent">
        <!-- Conteúdo dinâmico injetado via JS -->
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
        <button class="btn btn-primary" onclick="printReport()">Imprimir</button>
      </div>
    </div>
  </div>




</div>




<div class="admin-dashboard fade-in-soft">
  <div class="container-fluid">
    <div class="row mb-4">
      <div class="col-12">
        <div class="admin-card">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h2 class="fw-bold mb-1">
                <i class="fas fa-user-tie me-2"></i> Gerenciar Barbeiros
              </h2>
              <p class="text-muted mb-0">Visualize e gerencie os profissionais cadastrados</p>
            </div>
            <div>
             <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#barberModal">
              <i class="fas fa-plus me-2"></i> Novo Barbeiro
            </button>
            </div>
          </div>
        </div>
      </div>
    </div>


